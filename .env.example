NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Local Postgres (pgAdmin) — create DB "walit_pos" first
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for default Windows install:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/walit_pos

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_STATION_TTL=12h
JWT_PIN_ACCESS_TTL=10h
JWT_REFRESH_TTL=7d

# Google Sign-In (optional) — OAuth 2.0 Web client ID
# Same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Optional: Pollinations.ai product image generation (free image.pollinations.ai works without a key)
# POLLINATIONS_API_KEY=
# POLLINATIONS_IMAGE_BASE=https://image.pollinations.ai/prompt
# POLLINATIONS_MODEL=flux
# POLLINATIONS_WIDTH=768
# POLLINATIONS_HEIGHT=768

# Forgot-password / PIN OTP email (SMTP). Without these, OTP is only logged.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_SECURE=false
# Use a Gmail App Password (Google Account → Security → 2-Step → App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Universal POS <noreply@example.com>
# Optional extra: POST JSON { to, purpose, code, expiresAt } after OTP is created
AUTH_OTP_WEBHOOK_URL=

# Files (S3-compatible: AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=walit-pos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Payments — Stripe Test Mode
# Get keys: https://dashboard.stripe.com/test/apikeys
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Stripe Dashboard → Developers → Webhooks → signing secret (whsec_…)
# Endpoint: POST /v1/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
# Local/dev only if antivirus/proxy breaks Stripe TLS (UNABLE_TO_VERIFY_LEAF_SIGNATURE)
STRIPE_ALLOW_INSECURE_TLS=false
# Used for SaaS plan Stripe Checkout (tenant → POST /platform-billing/checkout)
# Frontend builds success/cancel URLs from window.location.origin
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# WhatsApp via Gupshup
# Dashboard: https://console.gupshup.io/ → create WhatsApp app → copy API key + number
# Sandbox tip: source can be 917834811114 until your number is live
WHATSAPP_BSP=gupshup
WHATSAPP_API_KEY=
WHATSAPP_SOURCE_NUMBER=
WHATSAPP_APP_NAME=TuxedoPOS
# true = log-only mock send (works without real Gupshup keys)
WHATSAPP_MOCK=true

# WebAuthn / biometrics (optional — HTTPS or localhost required; HTTP IP will not work in Chrome)
# Leave WEBAUTHN_RP_ID empty to use the browser hostname. For a domain, set e.g. upos.walit.in
# ORIGIN = full FE origins, comma-separated (must match browser address bar)
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Universal POS
WEBAUTHN_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# CORS — production MUST be an explicit frontend allowlist (never origin:true).
# Comma-separated. Also unions PUBLIC_APP_URL and WEBAUTHN_ORIGIN.
# CORS_ALLOWED_ORIGINS=https://upos.walit.in,http://13.126.105.138:3000
# Optional: AUTH_LOGIN_THROTTLE_LIMIT=30
# Non-prod OTP: set AUTH_OTP_RETURN_CODE=0 to hide devCode locally. Production never returns it.

# Firebase Cloud Messaging (optional) — server-side push
# Prefer a JSON file (dotenv breaks multiline FIREBASE_SERVICE_ACCOUNT_JSON):
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Absolute link prefix for notification click-through (frontend origin)
PUBLIC_APP_URL=http://localhost:3000
# Or use Application Default Credentials:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Field / backup encryption (32+ char secret). Falls back to JWT_ACCESS_SECRET if empty.
SECURITY_DATA_KEY=
