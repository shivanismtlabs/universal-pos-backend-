NODE_ENV=development
PORT=3001
API_PREFIX=v1

# Local Postgres (pgAdmin) — create DB "walit_pos" first
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for default Windows install:
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/walit_pos

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_STATION_TTL=12h
JWT_PIN_ACCESS_TTL=10h
JWT_REFRESH_TTL=7d

# Google Sign-In (optional) — OAuth 2.0 Web client ID
# Same value as frontend NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Files (S3-compatible: AWS S3 or Cloudflare R2)
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=walit-pos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Payments — Stripe Test Mode
# Get keys: https://dashboard.stripe.com/test/apikeys
PAYMENT_PROVIDER=stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Local/dev only if antivirus/proxy breaks Stripe TLS (UNABLE_TO_VERIFY_LEAF_SIGNATURE)
STRIPE_ALLOW_INSECURE_TLS=false
# Used for SaaS plan Stripe Checkout (tenant → POST /platform-billing/checkout)
# Frontend builds success/cancel URLs from window.location.origin
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# WhatsApp via Gupshup
# Dashboard: https://console.gupshup.io/ → create WhatsApp app → copy API key + number
# Sandbox tip: source can be 917834811114 until your number is live
WHATSAPP_BSP=gupshup
WHATSAPP_API_KEY=
WHATSAPP_SOURCE_NUMBER=
WHATSAPP_APP_NAME=TuxedoPOS
# true = log-only mock send (works without real Gupshup keys)
WHATSAPP_MOCK=true

# WebAuthn / biometrics (optional)
# RP_ID = hostname only (localhost or upos.example.com)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Universal POS
WEBAUTHN_ORIGIN=http://localhost:3000
