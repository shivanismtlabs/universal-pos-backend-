model Expense {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  locationId       String?   @map("location_id") @db.Uuid
  categoryId       String?   @map("category_id") @db.Uuid
  expenseNumber    String?   @map("expense_number")
  amount           Decimal   @db.Decimal(12, 2)
  netAmount        Decimal?  @map("net_amount") @db.Decimal(12, 2)
  taxAmount        Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  taxRatePercent   Decimal?  @map("tax_rate_percent") @db.Decimal(6, 3)
  taxInclusive     Boolean   @default(false) @map("tax_inclusive")
  spentAt          DateTime  @map("spent_at") @db.Date
  paymentMethod    String    @default("cash") @map("payment_method")
  payee            String?
  reference        String?
  notes            String?
  isPettyCash      Boolean   @default(false) @map("is_petty_cash")
  isReimbursement  Boolean   @default(false) @map("is_reimbursement")
  receiptUrl       String?   @map("receipt_url")
  /// draft | pending | approved | rejected | voided
  status           String    @default("pending")
  approvedById     String?   @map("approved_by_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectReason     String?   @map("reject_reason")
  voidedAt         DateTime? @map("voided_at") @db.Timestamptz(6)
  createdById      String?   @map("created_by_id") @db.Uuid
  idempotencyKey   String?   @map("idempotency_key")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant                 @relation(fields: [tenantId], references: [id])
  location    Location?              @relation(fields: [locationId], references: [id])
  category    ExpenseCategory?       @relation(fields: [categoryId], references: [id])
  createdBy   User?                  @relation(fields: [createdById], references: [id])
  approvedBy  User?                  @relation("ExpenseApprovedBy", fields: [approvedById], references: [id])
  pettyLedger PettyCashLedgerEntry[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, spentAt])
  @@index([tenantId, status])
  @@index([tenantId, expenseNumber])
  @@map("expenses")
}

/// Small cash float per tenant (optional per location)
model PettyCashFund {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  name       String   @default("Petty cash")
  balance    Decimal  @default(0) @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  location Location?              @relation(fields: [locationId], references: [id])
  entries  PettyCashLedgerEntry[]

  @@unique([tenantId, locationId])
  @@map("petty_cash_funds")
}

model PettyCashLedgerEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  fundId       String   @map("fund_id") @db.Uuid
  /// opening | replenishment | expense | adjustment
  kind         String
  /// credit = into fund; debit = out of fund
  direction    String
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  expenseId    String?  @map("expense_id") @db.Uuid
  reference    String?
  notes        String?
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  fund    PettyCashFund @relation(fields: [fundId], references: [id])
  expense Expense?      @relation(fields: [expenseId], references: [id])

  @@index([tenantId, fundId, createdAt])
  @@map("petty_cash_ledger_entries")
}

/// Phase 2 loyalty path: coupons (codes % or ₹ off)
model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  code            String
  description     String?
  /// percent | fixed
  discountType    String    @map("discount_type")
  discountValue   Decimal   @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount  Decimal?  @map("min_order_amount") @db.Decimal(12, 2)
  maxRedemptions  Int?      @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  amountOff  Decimal  @map("amount_off") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  coupon   Coupon    @relation(fields: [couponId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, couponId])
  @@map("coupon_redemptions")
}

/// Sellable / reloadable gift card (redeem as payment at counter)
model GiftCard {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  code         String
  initialValue Decimal   @map("initial_value") @db.Decimal(12, 2)
  balance      Decimal   @db.Decimal(12, 2)
  currencyCode String    @default("INR") @map("currency_code") @db.Char(3)
  customerId   String?   @map("customer_id") @db.Uuid
  status       String    @default("active") // active | disabled | depleted
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  note         String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  customer Customer?     @relation(fields: [customerId], references: [id])
  txns     GiftCardTxn[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("gift_cards")
}

model GiftCardTxn {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  giftCardId String   @map("gift_card_id") @db.Uuid
  /// issue | redeem | adjust
  kind       String
  amount     Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal @map("balance_after") @db.Decimal(12, 2)
  orderId    String?  @map("order_id") @db.Uuid
  note       String?
  createdById String? @map("created_by_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  giftCard GiftCard @relation(fields: [giftCardId], references: [id])

  @@index([tenantId, giftCardId])
  @@map("gift_card_txns")
}

model LoyaltyLedgerEntry {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  /// earn | redeem | adjust
  kind       String
  points     Int
  balanceAfter Int    @map("balance_after")
  orderId    String?  @map("order_id") @db.Uuid
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@map("loyalty_ledger")
}

// =============================================================================
// MODULE: RENTAL (formal wear, bikes, cameras, costumes…)
// Core Order + StockUnit stay generic; rental specifics live here.
// =============================================================================

model ModRentalOrder {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  orderId         String               @unique @map("order_id") @db.Uuid
  partyId         String?              @map("party_id") @db.Uuid
  lifecycle       RentalOrderLifecycle @default(quote)
  eventDate       DateTime?            @map("event_date") @db.Date
  pickupDate      DateTime?            @map("pickup_date") @db.Date
  returnDueDate   DateTime?            @map("return_due_date") @db.Date
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  order  Order          @relation(fields: [orderId], references: [id])
  party  ModRentalParty? @relation(fields: [partyId], references: [id])

  @@map("mod_rental_orders")
}

model ModRentalParty {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  eventDate         DateTime? @map("event_date") @db.Date
  primaryCustomerId String?   @map("primary_customer_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  primaryCustomer Customer?              @relation("RentalPartyPrimary", fields: [primaryCustomerId], references: [id])
  members         ModRentalPartyMember[]
  rentalOrders    ModRentalOrder[]

  @@map("mod_rental_parties")
}

model ModRentalPartyMember {
