/// Serialized / unique physical asset (camera body, tuxedo piece, bike)
model StockUnit {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  locationId            String             @map("location_id") @db.Uuid
  productId             String             @map("product_id") @db.Uuid
  /// Optional link when unit is a specific catalog variant
  productVariantId      String?            @map("product_variant_id") @db.Uuid
  barcodeSku            String             @map("barcode_sku")
  variantLabel          String?            @map("variant_label")
  condition             StockUnitCondition @default(good)
  status                StockUnitStatus    @default(available)
  ownership             OwnershipType      @default(own)
  supplierId            String?            @map("supplier_id") @db.Uuid
  networkSourceTenantId String?            @map("network_source_tenant_id") @db.Uuid
  depositAmount         Decimal            @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  purchaseCost          Decimal?           @map("purchase_cost") @db.Decimal(12, 2)
  meta                  Json               @default("{}")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  location       Location           @relation(fields: [locationId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  productVariant ProductVariant?    @relation(fields: [productVariantId], references: [id])
  supplier       Supplier?          @relation(fields: [supplierId], references: [id])
  reservations   StockReservation[]
  movements      StockMovement[]
  orderItems     OrderItem[]
  orderFees      OrderFee[]
  returnEvents   ReturnEvent[]
  cleaningJobs   ModRentalCleaningJob[]
  damageRecords  ModRentalDamageRecord[]

  @@unique([tenantId, barcodeSku])
  @@index([tenantId, locationId, status])
  @@index([tenantId, productId])
  @@map("stock_units")
}

/// Quantity-tracked stock (grocery kg/L, pieces, packs…)
model StockLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Required — same code as product.skuCode (15–18 on create)
  sku       String   @db.VarChar(18)
  /// pcs | pack | kg | g | L | ml — drives qty validation & POS labels
  sellUnit  String   @default("pcs") @map("sell_unit") @db.VarChar(16)
  /// Optional variant dimension — empty variantKey = product-level stock
  variantId String?  @map("variant_id") @db.Uuid
  variantKey String  @default("") @map("variant_key") @db.VarChar(36)
  /// Fractional OK for kg/L (e.g. 2.500); whole numbers for pcs/pack/g/ml
  qtyOnHand Decimal  @default(0) @map("qty_on_hand") @db.Decimal(20, 8)
  /// Held for unfulfilled orders — not sellable, still physically on hand
  qtyReserved Decimal @default(0) @map("qty_reserved") @db.Decimal(20, 8)
  /// Issued transfers not yet received at destination
  qtyInTransit Decimal @default(0) @map("qty_in_transit") @db.Decimal(20, 8)
  /// Quarantine / damaged qty (still at location, not sellable)
  qtyDamaged Decimal @default(0) @map("qty_damaged") @db.Decimal(20, 8)
  /// Low-stock / reorder alert threshold (null = fall back to product.meta)
  reorderPoint Decimal? @map("reorder_point") @db.Decimal(20, 8)
  /// Suggested qty to order when at/below reorder point
  reorderQty   Decimal? @map("reorder_qty") @db.Decimal(20, 8)
  sellPrice Decimal  @default(0) @map("sell_price") @db.Decimal(12, 2)
  version   Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  location           Location            @relation(fields: [locationId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  variant            ProductVariant?     @relation(fields: [variantId], references: [id])
  orderItems         OrderItem[]
  purchaseOrderLines PurchaseOrderLine[]
  ledgerEntries      StockLedgerEntry[]
  countLines         StockCountLine[]
  adjustmentLines    StockAdjustmentLine[]
  goodsReceiptLines  GoodsReceiptLine[]

  @@unique([tenantId, locationId, productId, variantKey])
  /// Same product SKU may exist at multiple locations (multi-store)
  @@unique([tenantId, locationId, sku])
  @@index([tenantId, productId])
  @@map("stock_levels")
}

/// Qty movement ledger (stock in/out, transfer, PO, audit, damage, sale…)
enum StockLedgerType {
  stock_in
  stock_out
  adjustment
  transfer_in
  transfer_out
  purchase_receive
  purchase_return
  sale
  customer_return
  damage
  damage_restore
  audit
  opening
  consumption
  production_in
  production_out
  expiry
  reservation
  reservation_release
  rental_out
  rental_return
}

model StockLedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  locationId     String          @map("location_id") @db.Uuid
  productId      String          @map("product_id") @db.Uuid
  stockLevelId   String          @map("stock_level_id") @db.Uuid
  type           StockLedgerType
  /// Sellable on-hand before this mutation
  qtyBefore      Decimal         @default(0) @map("qty_before") @db.Decimal(20, 8)
  /// Signed qty change on sellable on-hand (can be 0 if only damaged moves)
  qtyDelta       Decimal         @map("qty_delta") @db.Decimal(20, 8)
  qtyAfter       Decimal         @map("qty_after") @db.Decimal(20, 8)
  damageDelta    Decimal         @default(0) @map("damage_delta") @db.Decimal(20, 8)
  variantId      String?         @map("variant_id") @db.Uuid
  batchId        String?         @map("batch_id") @db.Uuid
  stockUnitId    String?         @map("stock_unit_id") @db.Uuid
  reason         String?
  referenceType  String?         @map("reference_type")
  referenceId    String?         @map("reference_id") @db.Uuid
  actorUserId    String?         @map("actor_user_id") @db.Uuid
  idempotencyKey String?         @map("idempotency_key") @db.VarChar(120)
  meta           Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  location   Location   @relation(fields: [locationId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])
  stockLevel StockLevel @relation(fields: [stockLevelId], references: [id])
  actor      User?      @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, productId, createdAt])
  @@index([tenantId, idempotencyKey])
  @@map("stock_ledger_entries")
}

enum StockCountStatus {
  draft
  in_progress
  completed
  cancelled
}

/// Physical stock audit / stock-take session
model StockCountSession {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  locationId  String           @map("location_id") @db.Uuid
  status      StockCountStatus @default(draft)
  notes       String?
  startedById String?          @map("started_by_id") @db.Uuid
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  lines    StockCountLine[]

  @@index([tenantId, locationId, status])
  @@map("stock_count_sessions")
}

model StockCountLine {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sessionId    String   @map("session_id") @db.Uuid
  stockLevelId String   @map("stock_level_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  systemQty    Decimal  @map("system_qty") @db.Decimal(20, 8)
