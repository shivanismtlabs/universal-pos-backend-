generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// UNIVERSAL BUSINESS OPERATING SYSTEM — Phase 1 schema
// Core = industry-agnostic. Industry packs live under mod_* tables / modules.
// Legacy rental schema preserved as schema.rental-legacy.prisma for mapping.
// =============================================================================

// ─── Enums (generic) ────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  offboarded
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
}

enum LocationType {
  store
  branch
  warehouse
  clinic
  kitchen
  office
  other
}

enum MembershipStatus {
  invited
  active
  suspended
  terminated
}

enum TaxMode {
  none
  simple
  in_gst
  vat
}

enum ModuleStatus {
  installed
  enabled
  disabled
}

enum ProductKind {
  physical
  service
  digital
  bundle
}

enum FulfillmentMode {
  sale
  rental
  service
  subscription
}

enum StockUnitStatus {
  available
  reserved
  checked_out
  in_service
  cleaning
  repair
  retired
}

enum StockUnitCondition {
  new
  good
  damaged
}

enum OwnershipType {
  own
  consignment
  sub_rental
  network
}

enum ReservationStatus {
  held
  checked_out
  released
  cancelled
}

enum OrderKind {
  sale
  rental
  service
  subscription
  mixed
  return_order
}

enum CustomerSubscriptionStatus {
  active
  paused
  cancelled
  expired
}

enum OrderStatus {
  draft
  quoted
  confirmed
  in_progress
  ready
  fulfilled
  closed
  cancelled
}

enum OrderItemKind {
  product
  service
  stock_unit
  fee
  discount
  custom
}

enum PaymentType {
  payment
  refund
  deposit
  deposit_refund
}

enum PaymentMethod {
  cash
  card
  upi
  bank_transfer
  gateway
  store_credit
  collect_later
  other
}

enum PaymentStatus {
  pending
  succeeded
  failed
  cancelled
}

enum AppointmentStatus {
  scheduled
  checked_in
  completed
  no_show
  cancelled
}

enum DocumentType {
  invoice
  receipt
  agreement
  id_proof
  photo
  other
}

enum NotificationChannel {
  whatsapp
  sms
  email
  push
}

enum SyncStatus {
  accepted
  conflict
  rejected
}

enum PoType {
  purchase
  sub_rental
  special
  transfer
}

enum CustomFieldEntity {
  customer
  product
  order
  order_item
  stock_unit
  appointment
  employee
  location
}

enum OutboxStatus {
  pending
  published
  failed
}

// Rental-module specific (not Core order machine)
enum RentalOrderLifecycle {
  quote
  reserved
  fitted
  ready
  checked_out
  returned
  inspected
  closed
  cancelled
}

enum InspectStatus {
  clean_ready
  needs_cleaning
  damaged
}

// ─── Platform / SaaS billing ────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  limits       Json     @default("{}")
  features     Json     @default("{}")
  priceAmount  Decimal  @default(0) @map("price_amount") @db.Decimal(12, 2)
  currencyCode String   @default("INR") @map("currency_code") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@map("plans")
}

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(active)
  /// Legal tax id (GSTIN / VAT / EIN) — format validated by tax_mode helpers
  taxId        String?      @map("tax_id")
  taxMode      TaxMode      @default(in_gst) @map("tax_mode")
  currencyCode String       @default("INR") @map("currency_code") @db.Char(3)
  locale       String       @default("en-IN")
  timezone     String       @default("Asia/Kolkata")
  branding     Json         @default("{}")
  settings     Json         @default("{}")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations      Organization[]
  locations          Location[]
  departments        Department[]
  teams              Team[]
  users              User[]
  employees          Employee[]
  memberships        Membership[]
  subscriptions      TenantSubscription[]
  featureFlags       FeatureFlag[]
  tenantModules      TenantModule[]
  roles              Role[]
  auditLogs          AuditLog[]
  customers          Customer[]
  categories         Category[]
  products           Product[]
  suppliers          Supplier[]
  stockUnits         StockUnit[]
  stockLevels        StockLevel[]
  stockReservations  StockReservation[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  orders             Order[]
  orderItems         OrderItem[]
  appointments            Appointment[]
  payments                Payment[]
  orderFees               OrderFee[]
  invoices                Invoice[]
  returnEvents            ReturnEvent[]
  documents               Document[]
  notificationLogs        NotificationLog[]
  webhookEndpoints        WebhookEndpoint[]
  apiKeys                 ApiKey[]
  offlineSyncEvents       OfflineSyncEvent[]
  customerSubscriptions   CustomerSubscription[]
  customFieldDefs    CustomFieldDefinition[]
  customFieldValues  CustomFieldValue[]
  outboxEvents       OutboxEvent[]
  registerSessions   RegisterSession[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  coupons            Coupon[]
  couponRedemptions  CouponRedemption[]
  // rental module
  rentalOrders       ModRentalOrder[]
  rentalParties      ModRentalParty[]
  rentalMeasurements ModRentalMeasurement[]
  rentalCleaningJobs ModRentalCleaningJob[]
  rentalDamageRecords ModRentalDamageRecord[]
  identityMemberships IdentityTenantMembership[]

  @@map("tenants")
}

model TenantSubscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  seatsUsed        Int                @default(0) @map("seats_used")
  locationsUsed    Int                @default(0) @map("locations_used")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("tenant_subscriptions")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("feature_flags")
}

/// Platform module catalog (installable apps)
model Module {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  /// Module codes this module requires (e.g. rental → inventory, orders)
  dependsOn   String[] @default([]) @map("depends_on")
  /// Sidebar/nav contribution schema
  navSchema   Json     @default("[]") @map("nav_schema")
  /// Permission codes contributed
  permissions String[] @default([])
  isCore      Boolean  @default(false) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  moduleId   String       @map("module_id") @db.Uuid
  status     ModuleStatus @default(installed)
  config     Json         @default("{}")
  enabledAt  DateTime?    @map("enabled_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

// ─── Organization hierarchy ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  taxId     String?  @map("tax_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  locations Location[]

  @@unique([tenantId, code])
  @@map("organizations")
}

/// Store / branch / warehouse / clinic — one physical or logical place of work
model Location {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name           String
  code           String
  type           LocationType @default(store)
  address        String?
  regionCode     String?      @map("region_code")
  isActive       Boolean      @default(true) @map("is_active")
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  departments       Department[]
  usersPrimary      User[]             @relation("UserPrimaryLocation")
  memberships       Membership[]
  stockUnits        StockUnit[]
  stockLevels       StockLevel[]
  orders            Order[]
  appointments      Appointment[]
  offlineSyncEvents OfflineSyncEvent[]
  registerSessions  RegisterSession[]
  expenses          Expense[]
  userRoles         UserRole[]

  @@unique([tenantId, code])
  @@map("locations")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  name       String
  code       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  location Location?   @relation(fields: [locationId], references: [id])
  teams    Team[]
  memberships Membership[]

  @@unique([tenantId, code])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String
  code         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  memberships Membership[]

  @@unique([tenantId, code])
  @@map("teams")
}

// ─── Identity / employees / RBAC ────────────────────────────────────────────

/// Global person account (Zoho-style) — independent of any single shop/tenant.
model IdentityAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String?   @map("password_hash")
  fullName              String    @map("full_name")
  phone                 String?
  googleSub             String?   @unique @map("google_sub")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships IdentityTenantMembership[]

  @@map("identity_accounts")
}

/// Links a global identity to a tenant user row (multi-org).
model IdentityTenantMembership {
  id         String   @id @default(uuid()) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  identity IdentityAccount @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identityId, tenantId])
  @@index([identityId])
  @@map("identity_tenant_memberships")
}

/// Email OTP challenges for password / PIN recovery (Universal POS).
model AuthOtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  purpose      String // password_reset | pin_reset
  email        String
  targetUserId String?   @map("target_user_id") @db.Uuid
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose, createdAt])
  @@map("auth_otp_challenges")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  primaryLocationId     String?   @map("primary_location_id") @db.Uuid
  email                 String
  phone                 String?
  passwordHash          String    @map("password_hash")
  fullName              String    @map("full_name")
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  pinHash               String?   @map("pin_hash")
  pinSetAt              DateTime? @map("pin_set_at") @db.Timestamptz(6)
  failedPinAttempts     Int       @default(0) @map("failed_pin_attempts")
  pinLockedUntil        DateTime? @map("pin_locked_until") @db.Timestamptz(6)
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  primaryLocation    Location?           @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id])
  employee           Employee?
  memberships        Membership[]
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  stockMovements     StockMovement[]
  ordersCreated      Order[]             @relation("OrderCreatedBy")
  appointmentsAssigned Appointment[]     @relation("AppointmentAssignee")
  paymentsTaken      Payment[]
  returnsReceived    ReturnEvent[]       @relation("ReturnReceivedBy")
  returnsApproved    ReturnEvent[]       @relation("ReturnApprovedBy")
  registerSessions   RegisterSession[]
  rentalMeasurementsTaken ModRentalMeasurement[]
  expensesCreated    Expense[]
  identityMembership IdentityTenantMembership?

  @@unique([tenantId, email])
  @@map("users")
}

/// HR-ish profile extension (optional for tiny shops — can mirror user)
model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  employeeCode       String?          @map("employee_code")
  status             MembershipStatus @default(active)
  hiredAt            DateTime?        @map("hired_at") @db.Date
  terminatedAt       DateTime?        @map("terminated_at") @db.Date
  managerEmployeeId  String?          @map("manager_employee_id") @db.Uuid
  jobTitle           String?          @map("job_title")
  notes              String?
  meta               Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  manager Employee? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id])
  reports Employee[] @relation("EmployeeManager")

  @@unique([tenantId, employeeCode])
  @@map("employees")
}

/// Assignment of a user to location / department / team with a role
model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  locationId   String?          @map("location_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  teamId       String?          @map("team_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  status       MembershipStatus @default(active)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])

  @@index([tenantId, userId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  moduleCode String?  @map("module_code")
  description String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([userId, roleId, locationId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  action      String
  beforeAfter Json?    @map("before_after")
  ip          String?
  device      String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Customers (generic party) ──────────────────────────────────────────────

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  fullName           String    @map("full_name")
  phone              String
  email              String?
  notes              String?
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(6)
  /// Refunded to store credit / redeemed at counter
  storeCreditBalance Decimal   @default(0) @map("store_credit_balance") @db.Decimal(12, 2)
  /// Industry-agnostic bag (labels, tags, external ids)
  meta               Json      @default("{}")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  orders           Order[]
  appointments     Appointment[]
  documents        Document[]
  notificationLogs NotificationLog[]
  orderItemsWorn   OrderItem[]            @relation("ItemWearer")
  rentalPartyPrimary ModRentalParty[]     @relation("RentalPartyPrimary")
  rentalPartyMemberships ModRentalPartyMember[]
  rentalMeasurements ModRentalMeasurement[]
  customerSubscriptions CustomerSubscription[]
  couponRedemptions CouponRedemption[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, fullName])
  @@map("customers")
}

// ─── Catalog / inventory (commerce core) ────────────────────────────────────

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  parentId  String?  @map("parent_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name])
  @@map("categories")
}

model Product {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  name            String
  /// Required shop SKU — app enforces 15–18 chars on create
  skuCode         String          @map("sku_code") @db.VarChar(18)
  kind            ProductKind     @default(physical)
  fulfillmentMode FulfillmentMode @default(sale) @map("fulfillment_mode")
  description     String?
  photoUrl        String?         @map("photo_url")
  taxCode         String?         @map("tax_code")
  basePrice       Decimal         @default(0) @map("base_price") @db.Decimal(12, 2)
  trackSerial     Boolean         @default(false) @map("track_serial")
  trackQty        Boolean         @default(true) @map("track_qty")
  isActive        Boolean         @default(true) @map("is_active")
  meta            Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  stockUnits            StockUnit[]
  stockLevels           StockLevel[]
  orderItems            OrderItem[]
  customerSubscriptions CustomerSubscription[]

  @@unique([tenantId, skuCode])
  @@map("products")
}

/// Customer enrolled in a shop plan (commerce subscription mode — not SaaS billing)
model CustomerSubscription {
  id                 String                      @id @default(uuid()) @db.Uuid
  tenantId           String                      @map("tenant_id") @db.Uuid
  customerId         String                      @map("customer_id") @db.Uuid
  productId          String                      @map("product_id") @db.Uuid
  status             CustomerSubscriptionStatus  @default(active)
  billingPeriodDays  Int                         @map("billing_period_days")
  price              Decimal                     @db.Decimal(12, 2)
  startsAt           DateTime                    @map("starts_at") @db.Timestamptz(6)
  currentPeriodStart DateTime                    @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime                    @map("current_period_end") @db.Timestamptz(6)
  cancelledAt        DateTime?                   @map("cancelled_at") @db.Timestamptz(6)
  lastOrderId        String?                     @map("last_order_id") @db.Uuid
  meta               Json                        @default("{}")
  createdAt          DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, productId])
  @@map("customer_subscriptions")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  contact   String?
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  stockUnits     StockUnit[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

/// Serialized / unique physical asset (camera body, tuxedo piece, bike)
model StockUnit {
  id                    String             @id @default(uuid()) @db.Uuid
  tenantId              String             @map("tenant_id") @db.Uuid
  locationId            String             @map("location_id") @db.Uuid
  productId             String             @map("product_id") @db.Uuid
  barcodeSku            String             @map("barcode_sku")
  variantLabel          String?            @map("variant_label")
  condition             StockUnitCondition @default(good)
  status                StockUnitStatus    @default(available)
  ownership             OwnershipType      @default(own)
  supplierId            String?            @map("supplier_id") @db.Uuid
  networkSourceTenantId String?            @map("network_source_tenant_id") @db.Uuid
  depositAmount         Decimal            @default(0) @map("deposit_amount") @db.Decimal(12, 2)
  purchaseCost          Decimal?           @map("purchase_cost") @db.Decimal(12, 2)
  meta                  Json               @default("{}")
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  location      Location           @relation(fields: [locationId], references: [id])
  product       Product            @relation(fields: [productId], references: [id])
  supplier      Supplier?          @relation(fields: [supplierId], references: [id])
  reservations  StockReservation[]
  movements     StockMovement[]
  orderItems    OrderItem[]
  orderFees     OrderFee[]
  returnEvents  ReturnEvent[]
  cleaningJobs  ModRentalCleaningJob[]
  damageRecords ModRentalDamageRecord[]

  @@unique([tenantId, barcodeSku])
  @@index([tenantId, locationId, status])
  @@map("stock_units")
}

/// Quantity-tracked stock (grocery kg/L, pieces, packs…)
model StockLevel {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  locationId String  @map("location_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Required — same code as product.skuCode (15–18 on create)
  sku       String   @db.VarChar(18)
  /// pcs | pack | kg | g | L | ml — drives qty validation & POS labels
  sellUnit  String   @default("pcs") @map("sell_unit") @db.VarChar(8)
  /// Fractional OK for kg/L (e.g. 2.500); whole numbers for pcs/pack/g/ml
  qtyOnHand Decimal  @default(0) @map("qty_on_hand") @db.Decimal(12, 3)
  sellPrice Decimal  @default(0) @map("sell_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  location           Location            @relation(fields: [locationId], references: [id])
  product            Product             @relation(fields: [productId], references: [id])
  orderItems         OrderItem[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, locationId, productId])
  /// Same product SKU may exist at multiple locations (multi-store)
  @@unique([tenantId, locationId, sku])
  @@index([tenantId, productId])
  @@map("stock_levels")
}

model StockReservation {
  id          String            @id @default(uuid()) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  stockUnitId String            @map("stock_unit_id") @db.Uuid
  orderItemId String?           @map("order_item_id") @db.Uuid
  startDate   DateTime          @map("start_date") @db.Date
  endDate     DateTime          @map("end_date") @db.Date
  status      ReservationStatus @default(held)
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit  @relation(fields: [stockUnitId], references: [id])
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([stockUnitId, startDate, endDate])
  @@map("stock_reservations")
}

model StockMovement {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  stockUnitId String          @map("stock_unit_id") @db.Uuid
  fromStatus  StockUnitStatus? @map("from_status")
  toStatus    StockUnitStatus @map("to_status")
  reason      String?
  orderId     String?         @map("order_id") @db.Uuid
  actorUserId String?         @map("actor_user_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])
  actor     User?     @relation(fields: [actorUserId], references: [id])

  @@map("stock_movements")
}

model PurchaseOrder {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  linkedOrderId    String?   @map("linked_order_id") @db.Uuid
  poType           PoType    @default(purchase) @map("po_type")
  expectedDelivery DateTime? @map("expected_delivery") @db.Date
  status           String    @default("draft")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@map("purchase_orders")
}

/// Qty lines on a purchase order — receive increments StockLevel
model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  stockLevelId    String   @map("stock_level_id") @db.Uuid
  qtyOrdered      Int      @map("qty_ordered")
  qtyReceived     Int      @default(0) @map("qty_received")
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockLevel    StockLevel    @relation(fields: [stockLevelId], references: [id])

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

// ─── Orders / payments / POS ────────────────────────────────────────────────

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  locationId    String      @map("location_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  orderNumber   String      @map("order_number")
  kind          OrderKind   @default(sale)
  status        OrderStatus @default(draft)
  currencyCode  String      @default("INR") @map("currency_code") @db.Char(3)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  depositTotal  Decimal     @default(0) @map("deposit_total") @db.Decimal(12, 2)
  balanceDue    Decimal     @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdById   String?     @map("created_by") @db.Uuid
  meta          Json        @default("{}")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  createdBy    User?             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items        OrderItem[]
  appointments Appointment[]
  payments     Payment[]
  fees         OrderFee[]
  invoices     Invoice[]
  returnEvents ReturnEvent[]
  documents    Document[]
  rentalExt    ModRentalOrder?
  layaways     LayawaySchedule[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, kind])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  itemKind      OrderItemKind @map("item_kind")
  productId     String?       @map("product_id") @db.Uuid
  stockUnitId   String?       @map("stock_unit_id") @db.Uuid
  stockLevelId  String?       @map("stock_level_id") @db.Uuid
  wearerCustomerId String?    @map("wearer_customer_id") @db.Uuid
  description   String?
  quantity      Decimal       @default(1) @db.Decimal(12, 3)
  unitPrice     Decimal       @default(0) @map("unit_price") @db.Decimal(12, 2)
  lineTotal     Decimal       @default(0) @map("line_total") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  meta          Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  order       Order              @relation(fields: [orderId], references: [id])
  product     Product?           @relation(fields: [productId], references: [id])
  stockUnit   StockUnit?         @relation(fields: [stockUnitId], references: [id])
  stockLevel  StockLevel?        @relation(fields: [stockLevelId], references: [id])
  wearer      Customer?          @relation("ItemWearer", fields: [wearerCustomerId], references: [id])
  reservations StockReservation[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  type                  PaymentType   @default(payment)
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(12, 2)
  currencyCode          String        @default("INR") @map("currency_code") @db.Char(3)
  idempotencyKey        String        @map("idempotency_key")
  gatewayRef            String?       @map("gateway_ref")
  gatewayPayload        Json?         @map("gateway_payload")
  takenByUserId         String?       @map("taken_by_user_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  order   Order  @relation(fields: [orderId], references: [id])
  takenBy User?  @relation(fields: [takenByUserId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@map("payments")
}

model OrderFee {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  stockUnitId String?  @map("stock_unit_id") @db.Uuid
  feeCode     String   @map("fee_code")
  reason      String?
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  stockUnit StockUnit? @relation(fields: [stockUnitId], references: [id])

  @@map("order_fees")
}

model LayawaySchedule {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  dueBy             DateTime  @map("due_by") @db.Date
  installmentAmount Decimal   @map("installment_amount") @db.Decimal(12, 2)
  status            String    @default("pending")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("layaway_schedules")
}

model Invoice {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  invoiceNumber String  @map("invoice_number")
  taxIdSnapshot String? @map("tax_id_snapshot")
  /// Flexible tax breakdown: { cgst, sgst, igst } or { vat } etc.
  taxBreakdown Json     @default("{}") @map("tax_breakdown")
  cgst         Decimal  @default(0) @db.Decimal(12, 2)
  sgst         Decimal  @default(0) @db.Decimal(12, 2)
  igst         Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal  @map("grand_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model ReturnEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  stockUnitId     String?  @map("stock_unit_id") @db.Uuid
  receivedById    String?  @map("received_by") @db.Uuid
  approvedById    String?  @map("approved_by") @db.Uuid
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  stockUnit  StockUnit? @relation(fields: [stockUnitId], references: [id])
  receivedBy User?      @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  approvedBy User?      @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  @@map("return_events")
}

/// Open cash drawer / register shift (POS module)
model RegisterSession {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  locationId  String    @map("location_id") @db.Uuid
  openedById  String    @map("opened_by") @db.Uuid
  openingFloat Decimal  @default(0) @map("opening_float") @db.Decimal(12, 2)
  closingCash  Decimal? @map("closing_cash") @db.Decimal(12, 2)
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
  meta        Json      @default("{}")

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  openedBy User     @relation(fields: [openedById], references: [id])

  @@index([tenantId, locationId, closedAt])
  @@map("register_sessions")
}

// ─── Appointments (generic booking — salon, fitting, clinic) ────────────────

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  customerId   String?           @map("customer_id") @db.Uuid
  orderId      String?           @map("order_id") @db.Uuid
  assigneeId   String?           @map("assignee_id") @db.Uuid
  /// Free-form type: fitting | haircut | consultation | pickup …
  type         String
  status       AppointmentStatus @default(scheduled)
  startsAt     DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?         @map("ends_at") @db.Timestamptz(6)
  notes        String?
  meta         Json              @default("{}")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  assignee User?     @relation("AppointmentAssignee", fields: [assigneeId], references: [id])

  @@index([tenantId, startsAt])
  @@map("appointments")
}

// ─── Documents / notify / integrations / sync ───────────────────────────────

model Document {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  customerId String?      @map("customer_id") @db.Uuid
  orderId    String?      @map("order_id") @db.Uuid
  type       DocumentType
  storageKey String       @map("storage_key")
  meta       Json         @default("{}")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])

  @@map("documents")
}

model NotificationLog {
  id           String              @id @default(uuid()) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  customerId   String?             @map("customer_id") @db.Uuid
  channel      NotificationChannel
  templateKey  String              @map("template_key")
  status       String
  payload      Json                @default("{}")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, createdAt])
  @@map("notification_logs")
}

model WebhookEndpoint {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  url       String
  secret    String?
  events    String[] @default([])
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("webhook_endpoints")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_keys")
}

model OfflineSyncEvent {
  id            String     @id @default(uuid()) @db.Uuid
  tenantId      String     @map("tenant_id") @db.Uuid
  locationId    String?    @map("location_id") @db.Uuid
  deviceId      String     @map("device_id")
  clientEventId String     @default(uuid()) @map("client_event_id")
  eventType     String     @map("event_type")
  payload       Json
  status        SyncStatus @default(accepted)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([tenantId, clientEventId])
  @@index([tenantId, deviceId, createdAt])
  @@map("offline_sync_events")
}

model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  eventType   String       @map("event_type")
  aggregateType String     @map("aggregate_type")
  aggregateId String       @map("aggregate_id") @db.Uuid
  payload     Json
  status      OutboxStatus @default(pending)
  attempts    Int          @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
  @@map("outbox_events")
}

// ─── Metadata / dynamic forms ───────────────────────────────────────────────

model CustomFieldDefinition {
  id         String            @id @default(uuid()) @db.Uuid
  tenantId   String            @map("tenant_id") @db.Uuid
  entity     CustomFieldEntity
  fieldKey   String            @map("field_key")
  label      String
  dataType   String            @map("data_type")
  required   Boolean           @default(false)
  options    Json              @default("[]")
  moduleCode String?           @map("module_code")
  sortOrder  Int               @default(0) @map("sort_order")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant             @relation(fields: [tenantId], references: [id])
  values CustomFieldValue[]

  @@unique([tenantId, entity, fieldKey])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  definitionId String @map("definition_id") @db.Uuid
  entityId   String   @map("entity_id") @db.Uuid
  valueText  String?  @map("value_text")
  valueNumber Decimal? @map("value_number") @db.Decimal(18, 4)
  valueJson  Json?    @map("value_json")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  definition CustomFieldDefinition  @relation(fields: [definitionId], references: [id])

  @@unique([definitionId, entityId])
  @@index([tenantId, entityId])
  @@map("custom_field_values")
}

// ─── Phase 2: expenses + loyalty coupons ────────────────────────────────────

model ExpenseCategory {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  expenses Expense[]

  @@unique([tenantId, name])
  @@map("expense_categories")
}

model Expense {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  categoryId      String?  @map("category_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  spentAt         DateTime @map("spent_at") @db.Date
  paymentMethod   String   @default("cash") @map("payment_method")
  notes           String?
  isPettyCash     Boolean  @default(false) @map("is_petty_cash")
  createdById     String?  @map("created_by_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  location  Location?        @relation(fields: [locationId], references: [id])
  category  ExpenseCategory? @relation(fields: [categoryId], references: [id])
  createdBy User?            @relation(fields: [createdById], references: [id])

  @@index([tenantId, spentAt])
  @@map("expenses")
}

/// Phase 2 loyalty path: coupons (codes % or ₹ off)
model Coupon {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  code            String
  description     String?
  /// percent | fixed
  discountType    String    @map("discount_type")
  discountValue   Decimal   @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount  Decimal?  @map("min_order_amount") @db.Decimal(12, 2)
  maxRedemptions  Int?      @map("max_redemptions")
  redemptionCount Int       @default(0) @map("redemption_count")
  isActive        Boolean   @default(true) @map("is_active")
  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  couponId   String   @map("coupon_id") @db.Uuid
  orderId    String?  @map("order_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  amountOff  Decimal  @map("amount_off") @db.Decimal(12, 2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  coupon   Coupon    @relation(fields: [couponId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([tenantId, couponId])
  @@map("coupon_redemptions")
}

// =============================================================================
// MODULE: RENTAL (formal wear, bikes, cameras, costumes…)
// Core Order + StockUnit stay generic; rental specifics live here.
// =============================================================================

model ModRentalOrder {
  id              String               @id @default(uuid()) @db.Uuid
  tenantId        String               @map("tenant_id") @db.Uuid
  orderId         String               @unique @map("order_id") @db.Uuid
  partyId         String?              @map("party_id") @db.Uuid
  lifecycle       RentalOrderLifecycle @default(quote)
  eventDate       DateTime?            @map("event_date") @db.Date
  pickupDate      DateTime?            @map("pickup_date") @db.Date
  returnDueDate   DateTime?            @map("return_due_date") @db.Date
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  order  Order          @relation(fields: [orderId], references: [id])
  party  ModRentalParty? @relation(fields: [partyId], references: [id])

  @@map("mod_rental_orders")
}

model ModRentalParty {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  name              String
  eventDate         DateTime? @map("event_date") @db.Date
  primaryCustomerId String?   @map("primary_customer_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant                 @relation(fields: [tenantId], references: [id])
  primaryCustomer Customer?              @relation("RentalPartyPrimary", fields: [primaryCustomerId], references: [id])
  members         ModRentalPartyMember[]
  rentalOrders    ModRentalOrder[]

  @@map("mod_rental_parties")
}

model ModRentalPartyMember {
  partyId    String  @map("party_id") @db.Uuid
  customerId String  @map("customer_id") @db.Uuid
  roleLabel  String? @map("role_label")

  party    ModRentalParty @relation(fields: [partyId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])

  @@id([partyId, customerId])
  @@map("mod_rental_party_members")
}

model ModRentalMeasurement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  heightCm      Decimal? @map("height_cm") @db.Decimal(8, 2)
  weightKg      Decimal? @map("weight_kg") @db.Decimal(8, 2)
  chest         Decimal? @db.Decimal(8, 2)
  waist         Decimal? @db.Decimal(8, 2)
  inseam        Decimal? @db.Decimal(8, 2)
  sleeve        Decimal? @db.Decimal(8, 2)
  shoeSize      String?  @map("shoe_size")
  extras        Json     @default("{}")
  takenByUserId String?  @map("taken_by_user_id") @db.Uuid
  takenAt       DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  takenBy  User?    @relation(fields: [takenByUserId], references: [id])

  @@map("mod_rental_measurements")
}

model ModRentalCleaningJob {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stockUnitId String   @map("stock_unit_id") @db.Uuid
  status      String   @default("queued")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])

  @@map("mod_rental_cleaning_jobs")
}

model ModRentalDamageRecord {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  stockUnitId   String         @map("stock_unit_id") @db.Uuid
  inspectStatus InspectStatus  @map("inspect_status")
  notes         String?
  chargeAmount  Decimal?       @map("charge_amount") @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])

  @@map("mod_rental_damage_records")
}
