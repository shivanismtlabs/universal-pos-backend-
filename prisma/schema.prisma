  @@unique([tenantId, locationId, productId, batchCode])
  @@index([tenantId, productId])
  @@index([tenantId, expiresAt])
  @@map("product_batches")
}

/// Customer enrolled in a shop plan (commerce subscription mode — not SaaS billing)
