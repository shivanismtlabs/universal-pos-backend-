}

// ─── Appointments (generic booking — salon, fitting, clinic) ────────────────

model Appointment {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @map("tenant_id") @db.Uuid
  locationId   String            @map("location_id") @db.Uuid
  customerId   String?           @map("customer_id") @db.Uuid
  orderId      String?           @map("order_id") @db.Uuid
  assigneeId   String?           @map("assignee_id") @db.Uuid
  /// Optional bookable resource (table, room, vehicle, hall, …)
  resourceId   String?           @map("resource_id") @db.Uuid
  /// Free-form type: fitting | haircut | consultation | pickup …
  type         String
  status       AppointmentStatus @default(scheduled)
  startsAt     DateTime          @map("starts_at") @db.Timestamptz(6)
  endsAt       DateTime?         @map("ends_at") @db.Timestamptz(6)
  notes        String?
  meta         Json              @default("{}")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  order    Order?    @relation(fields: [orderId], references: [id])
  assignee User?     @relation("AppointmentAssignee", fields: [assigneeId], references: [id])
  resource Resource? @relation(fields: [resourceId], references: [id])

  @@index([tenantId, startsAt])
  @@index([tenantId, resourceId, startsAt])
  @@map("appointments")
}

/// Generic bookable resource — NOT restaurantTable / salonRoom tables
model Resource {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @map("tenant_id") @db.Uuid
  locationId String?        @map("location_id") @db.Uuid
  name       String
  /// Configurable type code: table | room | vehicle | equipment | desk | court | hall | …
  type       String         @db.VarChar(40)
  capacity   Int            @default(1)
  status     ResourceStatus @default(available)
  sortOrder  Int            @default(0) @map("sort_order")
  meta       Json           @default("{}")
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  appointments    Appointment[]
  workJobs        WorkJob[]
  restaurantTable RestaurantTable?

  @@index([tenantId, type, status])
  @@index([tenantId, locationId])
  @@map("resources")
}

/// Customer asset (device / vehicle / appliance) — used by optional jobs module
model WorkAsset {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String
  /// phone | laptop | vehicle | appliance | camera | other
  assetType  String   @map("asset_type") @db.VarChar(40)
  /// IMEI, VIN, serial, plate, …
  identifier String?  @db.VarChar(120)
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  jobs     WorkJob[]

  @@index([tenantId, customerId])
  @@index([tenantId, identifier])
  @@map("work_assets")
}

/// Generic work / repair job — optional vertical module, not retail core
model WorkJob {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  locationId    String?       @map("location_id") @db.Uuid
  customerId    String        @map("customer_id") @db.Uuid
  assetId       String?       @map("asset_id") @db.Uuid
  assigneeId    String?       @map("assignee_id") @db.Uuid
  resourceId    String?       @map("resource_id") @db.Uuid
  orderId       String?       @map("order_id") @db.Uuid
  title         String
  status        WorkJobStatus @default(received)
  problem       String?
  diagnosis     String?
  estimatedCost Decimal?      @map("estimated_cost") @db.Decimal(12, 2)
  finalCost     Decimal?      @map("final_cost") @db.Decimal(12, 2)
  dueAt         DateTime?     @map("due_at") @db.Timestamptz(6)
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz(6)
  meta          Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  location Location?      @relation(fields: [locationId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  asset    WorkAsset?     @relation(fields: [assetId], references: [id])
  assignee User?          @relation("WorkJobAssignee", fields: [assigneeId], references: [id])
  resource Resource?      @relation(fields: [resourceId], references: [id])
  order    Order?         @relation(fields: [orderId], references: [id])
  lines    WorkJobLine[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, customerId])
  @@map("work_jobs")
}

model WorkJobLine {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @map("tenant_id") @db.Uuid
  jobId       String          @map("job_id") @db.Uuid
  productId   String?         @map("product_id") @db.Uuid
  kind        WorkJobLineKind @default(other)
  description String
  qty         Decimal         @default(1) @db.Decimal(20, 8)
  unitPrice   Decimal         @default(0) @map("unit_price") @db.Decimal(12, 2)
  meta        Json            @default("{}")
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  job     WorkJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId, jobId])
  @@map("work_job_lines")
}

// ─── Documents / notify / integrations / sync ───────────────────────────────

model Document {
