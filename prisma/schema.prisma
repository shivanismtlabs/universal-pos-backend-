generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// UNIVERSAL BUSINESS OPERATING SYSTEM — Phase 1 schema
// Core = industry-agnostic. Industry packs live under mod_* tables / modules.
// Legacy rental schema preserved as schema.rental-legacy.prisma for mapping.
// =============================================================================

// ─── Enums (generic) ────────────────────────────────────────────────────────

enum TenantStatus {
  active
  suspended
  offboarded
}

enum SubscriptionStatus {
  active
  past_due
  cancelled
}

enum LocationType {
  store
  branch
  warehouse
  clinic
  kitchen
  office
  other
}

enum MembershipStatus {
  invited
  active
  suspended
  terminated
}

enum TaxMode {
  none
  simple
  in_gst
  vat
}

enum ModuleStatus {
  installed
  enabled
  disabled
}

enum ProductKind {
  physical
  service
  digital
  bundle
  rental
}

/// Catalog lifecycle — prefer soft archive over hard delete when used on sales
enum ProductStatus {
  active
  inactive
  draft
  archived
}

enum SupplierStatus {
  active
  inactive
  blocked
  on_hold
  archived
}

enum FulfillmentMode {
  sale
  rental
  service
  subscription
}

enum StockUnitStatus {
  available
  reserved
  checked_out
  in_service
  cleaning
  repair
  retired
  sold
  lost
}

enum StockUnitCondition {
  new
  good
  damaged
}

enum OwnershipType {
  own
  consignment
  sub_rental
  network
}

enum ReservationStatus {
  held
  checked_out
  released
  cancelled
}

enum OrderKind {
  sale
  rental
  service
  subscription
  mixed
  return_order
}

enum CustomerSubscriptionStatus {
  active
  paused
  cancelled
  expired
}

enum OrderStatus {
  draft
  quoted
  confirmed
  in_progress
  ready
  fulfilled
  closed
  cancelled
}

enum OrderItemKind {
  product
  service
  stock_unit
  fee
  discount
  custom
}

enum PaymentType {
  payment
  refund
  deposit
  deposit_refund
}

enum PaymentMethod {
  cash
  card
  upi
  bank_transfer
  gateway
  store_credit
  gift_card
  collect_later
  wallet
  qr
  emi
  other
}

enum PaymentStatus {
  created
  initiated
  pending
  processing
  succeeded
  failed
  cancelled
}

enum RegisterCashMovementKind {
  cash_in
  cash_drop
}

enum AppointmentStatus {
  scheduled
  checked_in
  completed
  no_show
  cancelled
}

/// Bookable / assignable resource (table, room, vehicle, hall, desk, …)
enum ResourceStatus {
  available
  occupied
  maintenance
  inactive
}

/// Customer-owned or tracked asset for jobs (phone, vehicle, appliance, …)
enum WorkJobStatus {
  received
  diagnosis
  approved
  in_progress
  ready
  completed
  cancelled
  picked_up
}

enum WorkJobLineKind {
  part
  labor
  other
}

enum DocumentType {
  invoice
  receipt
  agreement
  id_proof
  photo
  other
}

enum NotificationChannel {
  whatsapp
  sms
  email
  push
  in_app
}

enum SyncStatus {
  accepted
  conflict
  rejected
  retry
}

enum PoType {
  purchase
  sub_rental
  special
  transfer
}

enum CustomFieldEntity {
  customer
  product
  order
  order_item
  stock_unit
  appointment
  employee
  location
  resource
  work_asset
  work_job
  membership
}

enum OutboxStatus {
  pending
  published
  failed
}

// Rental-module specific (not Core order machine)
enum RentalOrderLifecycle {
  quote
  reserved
  fitted
  ready
  checked_out
  returned
  inspected
  closed
  cancelled
}

enum InspectStatus {
  clean_ready
  needs_cleaning
  damaged
}

// ─── Platform / SaaS billing ────────────────────────────────────────────────

model Plan {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  limits       Json     @default("{}")
  features     Json     @default("{}")
  priceAmount  Decimal  @default(0) @map("price_amount") @db.Decimal(12, 2)
  currencyCode String   @default("INR") @map("currency_code") @db.Char(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions TenantSubscription[]

  @@map("plans")
}

model Tenant {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  slug         String       @unique
  status       TenantStatus @default(active)
  /// Legal tax id (GSTIN / VAT / EIN) — format validated by tax_mode helpers
  taxId        String?      @map("tax_id")
  taxMode      TaxMode      @default(in_gst) @map("tax_mode")
  currencyCode String       @default("INR") @map("currency_code") @db.Char(3)
  locale       String       @default("en-IN")
  timezone     String       @default("Asia/Kolkata")
  branding     Json         @default("{}")
  settings     Json         @default("{}")
  /// Optional holding company — null until identity wraps this shop
  businessGroupId String?   @map("business_group_id") @db.Uuid
  /// Opt-in: other group operators may see this tenant's stock
  shareInventory  Boolean   @default(false) @map("share_inventory")
  shareSuppliers  Boolean   @default(false) @map("share_suppliers")
  shareCustomers  Boolean   @default(false) @map("share_customers")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  businessGroup      BusinessGroup? @relation(fields: [businessGroupId], references: [id])
  organizations      Organization[]
  locations          Location[]
  departments        Department[]
  teams              Team[]
  users              User[]
  employees          Employee[]
  memberships        Membership[]
  subscriptions      TenantSubscription[]
  featureFlags       FeatureFlag[]
  tenantModules      TenantModule[]
  roles              Role[]
  workShifts         WorkShift[]
  shiftAssignments   ShiftAssignment[]
  attendanceEntries  AttendanceEntry[]
  webAuthnCredentials WebAuthnCredential[]
  auditLogs          AuditLog[]
  customers          Customer[]
  categories         Category[]
  brands             Brand[]
  products           Product[]
  productVariants    ProductVariant[]
  productBundleLines ProductBundleLine[]
  productBatches     ProductBatch[]
  suppliers          Supplier[]
  supplierContacts   SupplierContact[]
  supplierAddresses  SupplierAddress[]
  supplierDocuments  SupplierDocument[]
  supplierNotes      SupplierNote[]
  stockUnits         StockUnit[]
  stockLevels        StockLevel[]
  stockLedgerEntries StockLedgerEntry[]
  stockCountSessions StockCountSession[]
  stockCountLines    StockCountLine[]
  stockAdjustments   StockAdjustment[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockReservations  StockReservation[]
  stockMovements     StockMovement[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  goodsReceipts      GoodsReceipt[]
  goodsReceiptLines  GoodsReceiptLine[]
  supplierInvoices   SupplierInvoice[]
  supplierPayments   SupplierPayment[]
  orders             Order[]
  orderItems         OrderItem[]
  appointments            Appointment[]
  resources               Resource[]
  workAssets              WorkAsset[]
  workJobs                WorkJob[]
  payments                Payment[]
  orderFees               OrderFee[]
  invoices                Invoice[]
  returnEvents            ReturnEvent[]
  refundReasons           RefundReason[]
  documents               Document[]
  notificationLogs        NotificationLog[]
  appNotifications        AppNotification[]
  userNotificationPrefs   UserNotificationPreference[]
  devicePushTokens        DevicePushToken[]
  webhookEndpoints        WebhookEndpoint[]
  stripeWebhookEvents     StripeWebhookEvent[]
  registerCashMovements   RegisterCashMovement[]
  apiKeys                 ApiKey[]
  offlineSyncEvents       OfflineSyncEvent[]
  customerSubscriptions   CustomerSubscription[]
  customFieldDefs    CustomFieldDefinition[]
  customFieldValues  CustomFieldValue[]
  outboxEvents       OutboxEvent[]
  registerSessions   RegisterSession[]
  expenseCategories  ExpenseCategory[]
  expenses           Expense[]
  pettyCashFunds     PettyCashFund[]
  pettyCashLedger    PettyCashLedgerEntry[]
  coupons            Coupon[]
  couponRedemptions  CouponRedemption[]
  giftCards          GiftCard[]
  giftCardTxns       GiftCardTxn[]
  loyaltyLedger      LoyaltyLedgerEntry[]
  storeCreditLedger  StoreCreditLedgerEntry[]
  customerNotes      CustomerNote[]
  // rental module
  rentalOrders       ModRentalOrder[]
  rentalParties      ModRentalParty[]
  rentalMeasurements ModRentalMeasurement[]
  rentalCleaningJobs ModRentalCleaningJob[]
  rentalDamageRecords ModRentalDamageRecord[]
  identityMemberships IdentityTenantMembership[]
  qtyReservations         QtyReservation[]
  inventoryIdempotency    InventoryIdempotency[]
  stockTransfers          StockTransfer[]
  unitConversions         UnitConversion[]
  productUnits            ProductUnit[]
  productionOrders        ProductionOrder[]
  /// Universal POS: 1:1 vertical config (order_fields / item_fields / ui_flow JSON)
  businessConfig     BusinessConfig?
  approvalPolicies        ApprovalPolicy[]
  approvalRequests        ApprovalRequest[]
  exceptionAlertRules     ExceptionAlertRule[]
  intercompanyAsSource    IntercompanyTransfer[] @relation("IcSourceTenant")
  intercompanyAsDest      IntercompanyTransfer[] @relation("IcDestTenant")
  spinOffs                BusinessSpinOff[]
  groupSupplierLinks      GroupSupplierLink[]
  groupCustomerLinks      GroupCustomerLink[]
  restaurantConfigs       RestaurantConfig[]
  restaurantFloors        RestaurantFloor[]
  restaurantTables        RestaurantTable[]
  kitchenStations         KitchenStation[]
  kitchenTickets          KitchenTicket[]
  kitchenTicketLines      KitchenTicketLine[]
  restaurantOrders        RestaurantOrder[]
  diningReservations      DiningReservation[]
  recipeStages            RecipeStage[]
  modifierGroups          ModifierGroup[]
  modifierOptions         ModifierOption[]
  productModifierGroups   ProductModifierGroup[]
  wastageEvents           WastageEvent[]
  glAccounts              GlAccount[]
  journalEntries          JournalEntry[]
  journalEntryLines       JournalEntryLine[]
  accountingPeriods       AccountingPeriod[]
  accountMappings         AccountMapping[]
  accountingTaxFacts      AccountingTaxFact[]
  integrationConnections  IntegrationConnection[]
  integrationExternalMaps IntegrationExternalMap[]
  integrationSyncJobs     IntegrationSyncJob[]
  integrationSyncLogs     IntegrationSyncLog[]
  authSessions            AuthSession[]

  @@index([businessGroupId])
  @@map("tenants")
}

/// Shop access/refresh session. Logout revokes one row; password reset / disable revokes all.
model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  refreshTokenHash String?   @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason     String?   @map("revoke_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([tenantId])
  @@map("auth_sessions")
}

model TenantSubscription {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @map("tenant_id") @db.Uuid
  planId           String             @map("plan_id") @db.Uuid
  status           SubscriptionStatus @default(active)
  currentPeriodEnd DateTime?          @map("current_period_end") @db.Timestamptz(6)
  seatsUsed        Int                @default(0) @map("seats_used")
  locationsUsed    Int                @default(0) @map("locations_used")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  plan   Plan   @relation(fields: [planId], references: [id])

  @@map("tenant_subscriptions")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("feature_flags")
}

/// Platform module catalog (installable apps)
model Module {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  /// Module codes this module requires (e.g. rental → inventory, orders)
  dependsOn   String[] @default([]) @map("depends_on")
  /// Sidebar/nav contribution schema
  navSchema   Json     @default("[]") @map("nav_schema")
  /// Permission codes contributed
  permissions String[] @default([])
  isCore      Boolean  @default(false) @map("is_core")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenantModules TenantModule[]

  @@map("modules")
}

model TenantModule {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  moduleId   String       @map("module_id") @db.Uuid
  status     ModuleStatus @default(installed)
  config     Json         @default("{}")
  enabledAt  DateTime?    @map("enabled_at") @db.Timestamptz(6)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@unique([tenantId, moduleId])
  @@map("tenant_modules")
}

// ─── Organization hierarchy ─────────────────────────────────────────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  code      String
  taxId     String?  @map("tax_id")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  locations Location[]

  @@unique([tenantId, code])
  @@map("organizations")
}

/// Store / branch / warehouse / clinic — one physical or logical place of work
model Location {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  organizationId String?      @map("organization_id") @db.Uuid
  name           String
  code           String
  type           LocationType @default(store)
  address        String?
  regionCode     String?      @map("region_code")
  isActive       Boolean      @default(true) @map("is_active")
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  organization      Organization?      @relation(fields: [organizationId], references: [id])
  departments       Department[]
  usersPrimary      User[]             @relation("UserPrimaryLocation")
  memberships       Membership[]
  stockUnits        StockUnit[]
  stockLevels       StockLevel[]
  productBatches    ProductBatch[]
  stockLedgerEntries StockLedgerEntry[]
  stockCountSessions StockCountSession[]
  stockAdjustments   StockAdjustment[]
  qtyReservations   QtyReservation[]
  stockTransfersFrom StockTransfer[] @relation("TransferFromLocation")
  stockTransfersTo   StockTransfer[] @relation("TransferToLocation")
  productionOrders  ProductionOrder[]
  orders            Order[]
  appointments      Appointment[]
  resources         Resource[]
  workJobs          WorkJob[]
  offlineSyncEvents OfflineSyncEvent[]
  registerSessions  RegisterSession[]
  expenses          Expense[]
  pettyCashFunds    PettyCashFund[]
  userRoles         UserRole[]
  shiftAssignments  ShiftAssignment[]
  attendanceEntries AttendanceEntry[]
  appNotifications  AppNotification[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]
  accountMappings   AccountMapping[]
  accountingTaxFacts AccountingTaxFact[]
  payments          Payment[]
  restaurantConfigs RestaurantConfig[]
  restaurantFloors  RestaurantFloor[]
  restaurantTables  RestaurantTable[]
  kitchenStations   KitchenStation[]
  kitchenTickets    KitchenTicket[]
  restaurantOrders  RestaurantOrder[]
  diningReservations DiningReservation[]
  wastageEvents     WastageEvent[]

  @@unique([tenantId, code])
  @@map("locations")
}

model Department {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  name       String
  code       String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  location Location?   @relation(fields: [locationId], references: [id])
  teams    Team[]
  memberships Membership[]

  @@unique([tenantId, code])
  @@map("departments")
}

model Team {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  departmentId String?  @map("department_id") @db.Uuid
  name         String
  code         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  memberships Membership[]

  @@unique([tenantId, code])
  @@map("teams")
}

// ─── Identity / employees / RBAC ────────────────────────────────────────────

/// Global person account (Zoho-style) — independent of any single shop/tenant.
model IdentityAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  email                 String    @unique
  passwordHash          String?   @map("password_hash")
  fullName              String    @map("full_name")
  phone                 String?
  googleSub             String?   @unique @map("google_sub")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  memberships IdentityTenantMembership[]
  ownedGroups BusinessGroup[] @relation("GroupOwner")
  groupMemberships BusinessGroupMembership[]

  @@map("identity_accounts")
}

/// Links a global identity to a tenant user row (multi-org).
model IdentityTenantMembership {
  id         String   @id @default(uuid()) @db.Uuid
  identityId String   @map("identity_id") @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  identity IdentityAccount @relation(fields: [identityId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identityId, tenantId])
  @@index([identityId])
  @@map("identity_tenant_memberships")
}

/// Email OTP challenges for password / PIN recovery (Universal POS).
model AuthOtpChallenge {
  id           String    @id @default(uuid()) @db.Uuid
  purpose      String // password_reset | pin_reset
  email        String
  targetUserId String?   @map("target_user_id") @db.Uuid
  codeHash     String    @map("code_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  attemptCount Int       @default(0) @map("attempt_count")
  consumedAt   DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email, purpose, createdAt])
  @@map("auth_otp_challenges")
}

/**
 * Universal POS — per-shop vertical brain (ERD: BUSINESS_CONFIG).
 *
 * BUSINESS = Tenant. Core tables never fork by industry.
 * item_fields / order_fields / ui_flow are JSON schemas the FE renders dynamically.
 * Actual values live on products.meta / orders.meta (extra_fields).
 */
model BusinessConfig {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @unique @map("tenant_id") @db.Uuid
  /// Profile id: retail | grocery | restaurant | salon | service | general | custom
  businessType String   @map("business_type") @db.VarChar(40)
  /// Form schema for Item extras → saved into products.meta
  itemFields   Json     @default("[]") @map("item_fields")
  /// Form schema for Order extras → saved into orders.meta
  orderFields  Json     @default("[]") @map("order_fields")
  /// Screens / nav / wizard steps
  uiFlow       Json     @default("{}") @map("ui_flow")
  /// Billing style flags (counter/table/appointment, split, park, requireCustomer)
  billing      Json     @default("{}")
  /// Optional free-form overrides / versioning
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_configs")
}

model User {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  primaryLocationId     String?   @map("primary_location_id") @db.Uuid
  email                 String
  phone                 String?
  passwordHash          String    @map("password_hash")
  fullName              String    @map("full_name")
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginAttempts   Int       @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime? @map("locked_until") @db.Timestamptz(6)
  pinHash               String?   @map("pin_hash")
  pinSetAt              DateTime? @map("pin_set_at") @db.Timestamptz(6)
  failedPinAttempts     Int       @default(0) @map("failed_pin_attempts")
  pinLockedUntil        DateTime? @map("pin_locked_until") @db.Timestamptz(6)
  refreshTokenHash      String?   @map("refresh_token_hash")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(6)
  passwordChangedAt     DateTime? @map("password_changed_at") @db.Timestamptz(6)
  lastLoginAt           DateTime? @map("last_login_at") @db.Timestamptz(6)
  /// AES-GCM ciphertext of TOTP shared secret (never store plaintext)
  totpSecretEnc         String?   @map("totp_secret_enc")
  totpEnabled           Boolean   @default(false) @map("totp_enabled")
  totpEnabledAt         DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// bcrypt hashes of one-time backup codes
  totpBackupHashes      Json      @default("[]") @map("totp_backup_hashes")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [tenantId], references: [id])
  primaryLocation    Location?           @relation("UserPrimaryLocation", fields: [primaryLocationId], references: [id])
  employee           Employee?
  memberships        Membership[]
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  adjustmentsCreated   StockAdjustment[]     @relation("AdjustmentCreatedBy")
  adjustmentsFinalized StockAdjustment[]     @relation("AdjustmentFinalizedBy")
  adjustmentsCancelled StockAdjustment[]     @relation("AdjustmentCancelledBy")
  stockMovements     StockMovement[]
  stockLedgerEntries StockLedgerEntry[]
  ordersCreated      Order[]             @relation("OrderCreatedBy")
  appointmentsAssigned Appointment[]     @relation("AppointmentAssignee")
  workJobsAssigned     WorkJob[]         @relation("WorkJobAssignee")
  paymentsTaken      Payment[]
  returnsReceived    ReturnEvent[]       @relation("ReturnReceivedBy")
  returnsApproved    ReturnEvent[]       @relation("ReturnApprovedBy")
  registerSessions   RegisterSession[]
  registerCashMovements RegisterCashMovement[]
  rentalMeasurementsTaken ModRentalMeasurement[]
  expensesCreated    Expense[]
  expensesApproved   Expense[]           @relation("ExpenseApprovedBy")
  identityMembership IdentityTenantMembership?
  authSessions       AuthSession[]
  shiftAssignments   ShiftAssignment[]
  attendanceEntries  AttendanceEntry[]
  webAuthnCredentials WebAuthnCredential[]
  storeCreditLedger   StoreCreditLedgerEntry[]
  customerNotes       CustomerNote[]
  appNotifications    AppNotification[]
  notificationPrefs   UserNotificationPreference[]
  devicePushTokens    DevicePushToken[]
  glAccountsCreated   GlAccount[]           @relation("GlAccountCreatedBy")
  journalsCreated     JournalEntry[]        @relation("JournalCreatedBy")
  journalsPosted      JournalEntry[]        @relation("JournalPostedBy")
  journalsReversed    JournalEntry[]        @relation("JournalReversedBy")
  periodsCreated      AccountingPeriod[]    @relation("PeriodCreatedBy")
  periodsClosed       AccountingPeriod[]    @relation("PeriodClosedBy")
  periodsReopened     AccountingPeriod[]    @relation("PeriodReopenedBy")
  mappingsCreated     AccountMapping[]      @relation("AccountMappingCreatedBy")
  integrationConnections IntegrationConnection[] @relation("IntegrationConnectedBy")
  approvalRequestsCreated  ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalRequestsResolved ApprovalRequest[] @relation("ApprovalResolvedBy")
  approvalStepsActed       ApprovalStep[]    @relation("ApprovalStepActor")
  intercompanyCreated      IntercompanyTransfer[] @relation("IcCreatedBy")
  intercompanyApproved     IntercompanyTransfer[] @relation("IcApprovedBy")
  kitchenTicketsCreated    KitchenTicket[]        @relation("KitchenTicketCreatedBy")
  kitchenTicketsCancelled  KitchenTicket[]        @relation("KitchenTicketCancelledBy")
  wastageEvents            WastageEvent[]

  @@unique([tenantId, email])
  @@map("users")
}

/// HR-ish profile extension (optional for tiny shops — can mirror user)
model Employee {
  id                 String           @id @default(uuid()) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  userId             String           @unique @map("user_id") @db.Uuid
  employeeCode       String?          @map("employee_code")
  status             MembershipStatus @default(active)
  hiredAt            DateTime?        @map("hired_at") @db.Date
  terminatedAt       DateTime?        @map("terminated_at") @db.Date
  managerEmployeeId  String?          @map("manager_employee_id") @db.Uuid
  jobTitle           String?          @map("job_title")
  notes              String?
  meta               Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  user    User      @relation(fields: [userId], references: [id])
  manager Employee? @relation("EmployeeManager", fields: [managerEmployeeId], references: [id])
  reports Employee[] @relation("EmployeeManager")

  @@unique([tenantId, employeeCode])
  @@map("employees")
}

/// Assignment of a user to location / department / team with a role
model Membership {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  locationId   String?          @map("location_id") @db.Uuid
  departmentId String?          @map("department_id") @db.Uuid
  teamId       String?          @map("team_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  status       MembershipStatus @default(active)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  user       User        @relation(fields: [userId], references: [id])
  location   Location?   @relation(fields: [locationId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  role       Role        @relation(fields: [roleId], references: [id])

  @@index([tenantId, userId])
  @@map("memberships")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  userRoles       UserRole[]
  memberships     Membership[]
  rolePermissions RolePermission[]

  @@unique([tenantId, code])
  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  moduleCode String?  @map("module_code")
  description String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  roleId     String  @map("role_id") @db.Uuid
  locationId String? @map("location_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id])
  role     Role      @relation(fields: [roleId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([userId, roleId, locationId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Named work shift template (e.g. Morning 09:00–17:00)
model WorkShift {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  code        String?
  /// HH:mm local
  startTime   String   @map("start_time")
  /// HH:mm local
  endTime     String   @map("end_time")
  /// 0=Sun … 6=Sat; empty = any day
  daysOfWeek  Int[]    @default([]) @map("days_of_week")
  color       String?
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments ShiftAssignment[]
  attendance  AttendanceEntry[]

  @@index([tenantId])
  @@map("work_shifts")
}

/// Staff assigned to a shift on a calendar date
model ShiftAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  shiftId    String   @map("shift_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  /// Calendar day (tenant local date at midnight UTC-ish; stored as date)
  workDate   DateTime @map("work_date") @db.Date
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shift    WorkShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id])
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([shiftId, userId, workDate])
  @@index([tenantId, workDate])
  @@map("shift_assignments")
}

/// Clock-in / clock-out attendance (also supports manual day entries)
model AttendanceEntry {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  locationId   String?   @map("location_id") @db.Uuid
  /// Calendar day for the attendance record (one per staff/day preferred)
  workDate     DateTime? @map("work_date") @db.Date
  shiftId      String?   @map("shift_id") @db.Uuid
  clockInAt    DateTime? @map("clock_in_at") @db.Timestamptz(6)
  clockOutAt   DateTime? @map("clock_out_at") @db.Timestamptz(6)
  /// Break length in minutes (deducted from worked time)
  breakMinutes Int       @default(0) @map("break_minutes")
  /// present | absent | half_day | late | early_leave | leave | holiday | off_day
  status       String    @default("present")
  /// pin | password | biometric | manual
  method       String    @default("manual")
  notes        String?
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location?  @relation(fields: [locationId], references: [id])
  shift    WorkShift? @relation(fields: [shiftId], references: [id])

  @@index([tenantId, userId, clockInAt])
  @@index([tenantId, userId, workDate])
  @@index([tenantId, workDate, status])
  @@map("attendance_entries")
}

/// WebAuthn / platform biometric (passkey) credentials
model WebAuthnCredential {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  credentialId    String   @unique @map("credential_id")
  publicKey       Bytes    @map("public_key")
  counter         BigInt   @default(0)
  deviceType      String?  @map("device_type")
  backedUp        Boolean  @default(false) @map("backed_up")
  transports      String[] @default([])
  label           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

/// Short-lived WebAuthn challenge storage
model WebAuthnChallenge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  email     String?
  challenge String
  type      String
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([challenge])
  @@map("webauthn_challenges")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  action      String
  beforeAfter Json?    @map("before_after")
  ip          String?
  device      String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Customers (generic party) ──────────────────────────────────────────────

model Customer {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  fullName           String    @map("full_name")
  phone              String
  email              String?
  notes              String?
  marketingOptIn     Boolean   @default(false) @map("marketing_opt_in")
  consentAt          DateTime? @map("consent_at") @db.Timestamptz(6)
  /// Optional birthday for reminders (marketingOptIn required to send)
  dateOfBirth        DateTime? @map("date_of_birth") @db.Date
  /// Refunded to store credit / redeemed at counter
  storeCreditBalance Decimal   @default(0) @map("store_credit_balance") @db.Decimal(12, 2)
  /// Loyalty points balance (earn on paid sales, redeem at counter)
  loyaltyPoints      Int       @default(0) @map("loyalty_points")
  /// Max open balance (dues) allowed; null = unlimited
  creditLimit        Decimal?  @map("credit_limit") @db.Decimal(12, 2)
  /// Industry-agnostic bag (labels, tags, external ids)
  meta               Json      @default("{}")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  orders           Order[]
  appointments     Appointment[]
  workAssets       WorkAsset[]
  workJobs         WorkJob[]
  documents        Document[]
  notificationLogs NotificationLog[]
  orderItemsWorn   OrderItem[]            @relation("ItemWearer")
  rentalPartyPrimary ModRentalParty[]     @relation("RentalPartyPrimary")
  rentalPartyMemberships ModRentalPartyMember[]
  rentalMeasurements ModRentalMeasurement[]
  customerSubscriptions CustomerSubscription[]
  couponRedemptions CouponRedemption[]
  giftCards        GiftCard[]
  loyaltyLedger    LoyaltyLedgerEntry[]
  storeCreditLedger StoreCreditLedgerEntry[]
  customerNotes    CustomerNote[]
  journalEntryLines JournalEntryLine[]

  @@unique([tenantId, phone])
  @@index([tenantId, createdAt])
  @@index([tenantId, fullName])
  @@index([tenantId, dateOfBirth])
  @@map("customers")
}

/// Manual / counter store-credit movements (wallet ledger)
model StoreCreditLedgerEntry {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  /// credit | debit | adjust
  kind         String
  amount       Decimal  @db.Decimal(12, 2)
  balanceAfter Decimal  @map("balance_after") @db.Decimal(12, 2)
  orderId      String?  @map("order_id") @db.Uuid
  note         String?
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  actor    User?    @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@map("store_credit_ledger")
}

/// CRM note timeline (keeps Customer.notes as latest summary)
model CustomerNote {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  body        String
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@index([tenantId, customerId, createdAt])
  @@map("customer_notes")
}

// ─── Catalog / inventory (commerce core) ────────────────────────────────────
// Catalog = what the product is. Inventory (StockLevel / StockUnit / Batch qty) =
// how many / where. Never store location SOH columns as the product master.

model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("brands")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  name        String
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  imageUrl    String?  @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId, parentId])
  @@map("categories")
}

model Product {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  categoryId      String?         @map("category_id") @db.Uuid
  brandId         String?         @map("brand_id") @db.Uuid
  name            String
  shortName       String?         @map("short_name")
  /// Required shop SKU — unique per tenant (2–18 chars validated in app)
  skuCode         String          @map("sku_code") @db.VarChar(18)
  /// Scan identifier — separate from SKU
  barcode         String?         @db.VarChar(64)
  /// Symbology for labels: code128 (default) | ean13 | upca | ean8
  barcodeType     String?         @map("barcode_type") @db.VarChar(16)
  /// Optional QR payload (defaults to structured catalog ref when empty)
  qrCode          String?         @map("qr_code") @db.VarChar(255)
  internalCode    String?         @map("internal_code") @db.VarChar(64)
  kind            ProductKind     @default(physical)
  status          ProductStatus   @default(active)
  fulfillmentMode FulfillmentMode @default(sale) @map("fulfillment_mode")
  /// Short blurb for POS cards / list
  shortDescription String?        @map("short_description")
  /// Full description for detail / future e-com
  description     String?
  photoUrl        String?         @map("photo_url")
  /// Generic tax reference (GST/VAT etc. interpreted by tax module)
  taxCode         String?         @map("tax_code")
  /// Selling price (catalog default; stock level may override per location)
  basePrice       Decimal         @default(0) @map("base_price") @db.Decimal(12, 2)
  costPrice       Decimal?        @map("cost_price") @db.Decimal(12, 2)
  /// MRP / list price
  mrp             Decimal?        @db.Decimal(12, 2)
  /// Unit of measure code: pcs, kg, L, hour, service… (legacy; prefer baseUnitId)
  unitOfMeasure   String          @default("pcs") @map("unit_of_measure") @db.VarChar(32)
  /// Canonical inventory unit (Unit master). Null = legacy unitOfMeasure only.
  baseUnitId      String?         @map("base_unit_id") @db.Uuid
  /// Optional pricing unit; null = same as base
  pricingUnitId   String?         @map("pricing_unit_id") @db.Uuid
  pricingStrategy PricingStrategy @default(converted) @map("pricing_strategy")
  /// Used when pricingStrategy = converted
  pricePerPricingUnit Decimal?    @map("price_per_pricing_unit") @db.Decimal(14, 4)
  trackSerial     Boolean         @default(false) @map("track_serial")
  trackBatch      Boolean         @default(false) @map("track_batch")
  trackQty        Boolean         @default(true) @map("track_qty")
  canSell         Boolean         @default(true) @map("can_sell")
  canPurchase     Boolean         @default(true) @map("can_purchase")
  availableInPos  Boolean         @default(true) @map("available_in_pos")
  /// Derived from status for legacy POS filters
  isActive        Boolean         @default(true) @map("is_active")
  /// Dynamic vertical data (ERD: ITEM.extra_fields). e.g. images[], extra fields
  meta            Json            @default("{}") @map("meta")
  createdById     String?         @map("created_by_id") @db.Uuid
  updatedById     String?         @map("updated_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  category    Category?    @relation(fields: [categoryId], references: [id])
  brand       Brand?       @relation(fields: [brandId], references: [id])
  variants              ProductVariant[]
  bundleComponents      ProductBundleLine[] @relation("BundleParent")
  usedInBundles         ProductBundleLine[] @relation("BundleComponent")
  batches               ProductBatch[]
  stockUnits            StockUnit[]
  stockLevels           StockLevel[]
  orderItems            OrderItem[]
  customerSubscriptions CustomerSubscription[]
  stockLedgerEntries    StockLedgerEntry[]
  stockCountLines       StockCountLine[]
  stockAdjustmentLines  StockAdjustmentLine[]
  workJobLines          WorkJobLine[]
  qtyReservations       QtyReservation[]
  unitConversions       UnitConversion[]
  productUnits          ProductUnit[]
  productionOrders      ProductionOrder[]
  recipeStages          RecipeStage[]
  modifierLinks         ProductModifierGroup[]
  modifierIngredientOf  ModifierOption[] @relation("modifierIngredient")
  baseUnit              Unit?            @relation("ProductBaseUnit", fields: [baseUnitId], references: [id])
  pricingUnit           Unit?            @relation("ProductPricingUnit", fields: [pricingUnitId], references: [id])

  @@unique([tenantId, skuCode])
  @@index([tenantId, status])
  @@index([tenantId, brandId])
  @@index([tenantId, categoryId])
  @@index([tenantId, barcode])
  @@index([tenantId, baseUnitId])
  @@map("products")
}

/// Optional sellable variant (size / color / weight…) — own SKU/barcode
model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String
  skuCode      String   @map("sku_code") @db.VarChar(18)
  barcode      String?  @db.VarChar(64)
  /// { "size": "42", "color": "Black", "weight": "0.5" }
  attributes   Json     @default("{}")
  basePrice    Decimal? @map("base_price") @db.Decimal(12, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  isActive     Boolean  @default(true) @map("is_active")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  product  Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  batches  ProductBatch[]
  stockUnits StockUnit[]
  stockLevels StockLevel[]
  qtyReservations QtyReservation[]

  @@unique([tenantId, skuCode])
  @@index([tenantId, productId])
  @@map("product_variants")
}

/// Bundle / combo bill-of-materials (stock from components)
model ProductBundleLine {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  bundleProductId      String   @map("bundle_product_id") @db.Uuid
  componentProductId   String   @map("component_product_id") @db.Uuid
  componentVariantId   String?  @map("component_variant_id") @db.Uuid
  quantity             Decimal  @default(1) @db.Decimal(20, 8)
  /// When true, selling/completing the parent consumes this component (recipe, kit, service).
  consumeOnSale        Boolean  @default(false) @map("consume_on_sale")
  /// bundle | recipe | production
  purpose              String   @default("bundle") @db.VarChar(24)
  /// Consumption unit (g, ml, pcs) — converted via UnitConversion when set
  unit                 String?  @db.VarChar(16)
  wastagePercent       Decimal  @default(0) @map("wastage_percent") @db.Decimal(6, 3)
  stageId              String?  @map("stage_id") @db.Uuid
  stageKey             String   @default("") @map("stage_key") @db.VarChar(64)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  bundleProduct    Product      @relation("BundleParent", fields: [bundleProductId], references: [id], onDelete: Cascade)
  componentProduct Product      @relation("BundleComponent", fields: [componentProductId], references: [id])
  stage            RecipeStage? @relation(fields: [stageId], references: [id])

  @@unique([bundleProductId, componentProductId, componentVariantId, stageKey])
  @@index([tenantId, bundleProductId])
  @@map("product_bundle_lines")
}

/// Batch / lot + expiry — inventory of a catalog product (location-aware qty)
