  /// goods | services | both | manufacturer | wholesaler | other
  supplierType String?     @map("supplier_type") @db.VarChar(40)
  category  String?        @db.VarChar(80)
  status    SupplierStatus @default(active)
  /// Primary contact display (denormalized)
  contact   String?
  designation String?
  phone     String?
  phoneAlt  String?        @map("phone_alt")
  email     String?
  website   String?
  notes     String?
  /// Generic tax identity (GSTIN / VAT / EIN / local) — not India-only
  taxId     String?        @map("tax_id") @db.VarChar(32)
  taxCategory String?      @map("tax_category") @db.VarChar(40)
  taxExempt Boolean        @default(false) @map("tax_exempt")
  registrationNo String?   @map("registration_no") @db.VarChar(64)
  /// immediate | net_7 | net_15 | net_30 | net_45 | net_60 | custom
  paymentTerm String?      @map("payment_term") @db.VarChar(32)
  dueDays   Int?           @map("due_days")
  creditLimit Decimal?     @map("credit_limit") @db.Decimal(14, 2)
  currencyCode String?     @map("currency_code") @db.Char(3)
  preferredPayMethod String? @map("preferred_pay_method") @db.VarChar(32)
  bankName        String?  @map("bank_name")
  bankAccountName String?  @map("bank_account_name")
  bankAccountNo   String?  @map("bank_account_no")
  bankIdentifier  String?  @map("bank_identifier")
  payHandle       String?  @map("pay_handle")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  contacts       SupplierContact[]
  addresses      SupplierAddress[]
  documents      SupplierDocument[]
  activityNotes  SupplierNote[]
  stockUnits     StockUnit[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  invoices       SupplierInvoice[]
  payments       SupplierPayment[]
  journalEntryLines JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@index([tenantId, name])
  @@map("suppliers")
}

model SupplierContact {
