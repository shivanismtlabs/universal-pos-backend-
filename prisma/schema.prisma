  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])
  actor     User?     @relation(fields: [actorUserId], references: [id])

  @@map("stock_movements")
}

/// Qty holds for sale/fulfillment — does not reduce physical on-hand until consumed
model QtyReservation {
  id           String               @id @default(uuid()) @db.Uuid
  tenantId     String               @map("tenant_id") @db.Uuid
  locationId   String               @map("location_id") @db.Uuid
  productId    String               @map("product_id") @db.Uuid
  variantId    String?              @map("variant_id") @db.Uuid
  batchId      String?              @map("batch_id") @db.Uuid
  stockLevelId String?              @map("stock_level_id") @db.Uuid
  orderId      String?              @map("order_id") @db.Uuid
  customerId   String?              @map("customer_id") @db.Uuid
  qty          Decimal              @db.Decimal(20, 8)
  status       QtyReservationStatus @default(active)
  expiresAt    DateTime?            @map("expires_at") @db.Timestamptz(6)
  reason       String?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  location Location        @relation(fields: [locationId], references: [id])
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([tenantId, locationId, productId, status])
  @@map("qty_reservations")
}

model InventoryIdempotency {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String   @db.VarChar(160)
  operation String   @db.VarChar(64)
  result    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@map("inventory_idempotency")
}

model StockTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  tenantId        String              @map("tenant_id") @db.Uuid
  fromLocationId  String              @map("from_location_id") @db.Uuid
  toLocationId    String              @map("to_location_id") @db.Uuid
  status          StockTransferStatus @default(draft)
  notes           String?
  actorUserId     String?             @map("actor_user_id") @db.Uuid
  issuedAt        DateTime?           @map("issued_at") @db.Timestamptz(6)
  receivedAt      DateTime?           @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant              @relation(fields: [tenantId], references: [id])
  from   Location            @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  to     Location            @relation("TransferToLocation", fields: [toLocationId], references: [id])
  lines  StockTransferLine[]

  @@index([tenantId, status, createdAt])
  @@map("stock_transfers")
}

model StockTransferLine {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  transferId       String   @map("transfer_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  variantId        String?  @map("variant_id") @db.Uuid
  batchId          String?  @map("batch_id") @db.Uuid
  qty              Decimal  @db.Decimal(20, 8)
  qtyReceived      Decimal  @default(0) @map("qty_received") @db.Decimal(20, 8)
  qtyDamaged       Decimal  @default(0) @map("qty_damaged") @db.Decimal(20, 8)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_lines")
}

/// 1 fromUnit = factor base/toUnit for a product (or tenant-wide if productId null)
model UnitConversion {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String?  @map("product_id") @db.Uuid
  productKey String   @default("") @map("product_key") @db.VarChar(36)
  fromUnit   String   @map("from_unit") @db.VarChar(16)
  toUnit     String   @map("to_unit") @db.VarChar(16)
  factor     Decimal  @db.Decimal(20, 8)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productKey, fromUnit, toUnit])
  @@map("unit_conversions")
}

/// WEIGHT | VOLUME | LENGTH | COUNT | TIME | CUSTOM
model UnitGroup {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(50)
  isActive Boolean @default(true) @map("is_active")

  units Unit[]

  @@map("unit_groups")
}

/// Global (and optional tenant-custom) unit master
model Unit {
  id                     String   @id @default(uuid()) @db.Uuid
  unitGroupId            String   @map("unit_group_id") @db.Uuid
  /// Null = system-wide unit; set for tenant CUSTOM units
  tenantId               String?  @map("tenant_id") @db.Uuid
  name                   String   @db.VarChar(50)
  symbol                 String   @db.VarChar(16)
  isBaseUnit             Boolean  @default(false) @map("is_base_unit")
  /// How many group-base units equal 1 of this unit (kg → 1000 if base = g)
  conversionToGroupBase  Decimal  @map("conversion_to_group_base") @db.Decimal(20, 8)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  unitGroup          UnitGroup     @relation(fields: [unitGroupId], references: [id])
  productUnits       ProductUnit[]
  productsAsBase     Product[]     @relation("ProductBaseUnit")
  productsAsPricing  Product[]     @relation("ProductPricingUnit")

  @@unique([unitGroupId, symbol])
  @@index([tenantId])
  @@map("units")
}

/// Product-specific selling/purchase units + conversion history (close old, insert new)
model ProductUnit {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  productId             String    @map("product_id") @db.Uuid
  unitId                String    @map("unit_id") @db.Uuid
  /// 1 of this unit = conversionToBase of product.baseUnit
  conversionToBase      Decimal   @map("conversion_to_base") @db.Decimal(20, 8)
  fixedPrice            Decimal?  @map("fixed_price") @db.Decimal(14, 4)
  isDefaultSellingUnit  Boolean   @default(false) @map("is_default_selling_unit")
  isPurchaseUnit        Boolean   @default(false) @map("is_purchase_unit")
  quantityPrecision     Int?      @map("quantity_precision")
  minQuantity           Decimal   @default(0) @map("min_quantity") @db.Decimal(20, 8)
  quantityStep          Decimal?  @map("quantity_step") @db.Decimal(20, 8)
  allowFraction         Boolean?  @map("allow_fraction")
  barcode               String?   @db.VarChar(64)
  effectiveFrom         DateTime  @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveTo           DateTime? @map("effective_to") @db.Timestamptz(6)
  createdById           String?   @map("created_by_id") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit    Unit    @relation(fields: [unitId], references: [id])

  @@unique([productId, unitId, effectiveFrom])
  @@index([tenantId, productId])
  @@index([productId, effectiveTo])
  @@index([tenantId, barcode])
  @@map("product_units")
}

model ProductionOrder {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  locationId         String                @map("location_id") @db.Uuid
  finishedProductId  String                @map("finished_product_id") @db.Uuid
  finishedVariantId  String?               @map("finished_variant_id") @db.Uuid
  qty                Decimal               @db.Decimal(20, 8)
  status             ProductionOrderStatus @default(draft)
  notes              String?
  actorUserId        String?               @map("actor_user_id") @db.Uuid
  completedAt        DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  location Location @relation(fields: [locationId], references: [id])
  finished Product @relation(fields: [finishedProductId], references: [id])

  @@index([tenantId, status])
  @@map("production_orders")
}

model PurchaseOrder {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  supplierId       String    @map("supplier_id") @db.Uuid
  linkedOrderId    String?   @map("linked_order_id") @db.Uuid
  poType           PoType    @default(purchase) @map("po_type")
  /// Human-readable PO number (tenant-scoped)
  poNumber         String?   @map("po_number")
  expectedDelivery DateTime? @map("expected_delivery") @db.Date
  status           String    @default("draft")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]
  invoices      SupplierInvoice[]

  @@index([tenantId, poNumber])
  @@map("purchase_orders")
}

/// Qty lines on a purchase order — receive increments StockLevel
model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  stockLevelId    String   @map("stock_level_id") @db.Uuid
  qtyOrdered      Decimal  @map("qty_ordered") @db.Decimal(20, 8)
  qtyReceived     Decimal  @default(0) @map("qty_received") @db.Decimal(20, 8)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  stockLevel    StockLevel    @relation(fields: [stockLevelId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_lines")
}

/// Goods Received Note — created when stock is received against a PO
model GoodsReceipt {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  purchaseOrderId String   @map("purchase_order_id") @db.Uuid
  grnNumber       String   @map("grn_number")
  notes           String?
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  supplier      Supplier           @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id])
  lines         GoodsReceiptLine[]
  invoices      SupplierInvoice[]

  @@unique([tenantId, grnNumber])
  @@index([tenantId, supplierId, receivedAt])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  goodsReceiptId      String   @map("goods_receipt_id") @db.Uuid
  stockLevelId        String   @map("stock_level_id") @db.Uuid
  purchaseOrderLineId String?  @map("purchase_order_line_id") @db.Uuid
  qty                 Decimal  @db.Decimal(20, 8)
  unitCost            Decimal? @map("unit_cost") @db.Decimal(12, 2)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  goodsReceipt      GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  stockLevel        StockLevel         @relation(fields: [stockLevelId], references: [id])
  purchaseOrderLine PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  @@index([tenantId, goodsReceiptId])
  @@map("goods_receipt_lines")
}

/// Supplier bill / AP invoice
model SupplierInvoice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  purchaseOrderId String?   @map("purchase_order_id") @db.Uuid
  goodsReceiptId  String?   @map("goods_receipt_id") @db.Uuid
  invoiceNumber   String    @map("invoice_number")
  invoiceDate     DateTime  @default(now()) @map("invoice_date") @db.Date
  dueDate         DateTime? @map("due_date") @db.Date
  subtotal        Decimal   @default(0) @db.Decimal(12, 2)
  taxTotal        Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal      Decimal   @default(0) @map("grand_total") @db.Decimal(12, 2)
  amountPaid      Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  /// open | partial | paid | void | credit
  status          String    @default("open")
  notes           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  supplier      Supplier          @relation(fields: [supplierId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  goodsReceipt  GoodsReceipt?     @relation(fields: [goodsReceiptId], references: [id])
  payments      SupplierPayment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, supplierId, status])
  @@index([tenantId, dueDate])
  @@map("supplier_invoices")
}

/// Payment against supplier AP (or unallocated supplier payment / supplier refund)
model SupplierPayment {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  supplierId        String   @map("supplier_id") @db.Uuid
  supplierInvoiceId String?  @map("supplier_invoice_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  /// cash | card | upi | bank_transfer | wallet | other…
  method            String   @default("bank_transfer")
  /// payment = money OUT to supplier; refund = money IN from supplier
  kind              String   @default("payment")
  reference         String?
  notes             String?
  actorUserId       String?  @map("actor_user_id") @db.Uuid
  paidAt            DateTime @default(now()) @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [supplierInvoiceId], references: [id])

  @@index([tenantId, supplierId, paidAt])
  @@index([tenantId, kind, paidAt])
  @@map("supplier_payments")
}

// ─── Orders / payments / POS ────────────────────────────────────────────────

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  locationId    String      @map("location_id") @db.Uuid
  customerId    String?     @map("customer_id") @db.Uuid
  orderNumber   String      @map("order_number")
  kind          OrderKind   @default(sale)
  status        OrderStatus @default(draft)
  currencyCode  String      @default("INR") @map("currency_code") @db.Char(3)
  subtotal      Decimal     @default(0) @db.Decimal(12, 2)
  taxTotal      Decimal     @default(0) @map("tax_total") @db.Decimal(12, 2)
  discountTotal Decimal     @default(0) @map("discount_total") @db.Decimal(12, 2)
  depositTotal  Decimal     @default(0) @map("deposit_total") @db.Decimal(12, 2)
  balanceDue    Decimal     @default(0) @map("balance_due") @db.Decimal(12, 2)
  createdById   String?     @map("created_by") @db.Uuid
  /// Dynamic vertical data (ERD: ORDERS.extra_fields). e.g. { "tableNumber":"5", "kot_status":"sent" }
  meta          Json        @default("{}") @map("meta")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  createdBy    User?             @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items        OrderItem[]
  appointments Appointment[]
  workJobs     WorkJob[]
  payments     Payment[]
  fees         OrderFee[]
  invoices     Invoice[]
  returnEvents ReturnEvent[]
  documents    Document[]
  rentalExt       ModRentalOrder?
  restaurantExt   RestaurantOrder?
  layaways        LayawaySchedule[]
  kitchenTickets  KitchenTicket[]
  restaurantTables RestaurantTable[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status, kind])
  @@map("orders")
}

model OrderItem {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  orderId       String        @map("order_id") @db.Uuid
  itemKind      OrderItemKind @map("item_kind")
  productId     String?       @map("product_id") @db.Uuid
  stockUnitId   String?       @map("stock_unit_id") @db.Uuid
  stockLevelId  String?       @map("stock_level_id") @db.Uuid
  wearerCustomerId String?    @map("wearer_customer_id") @db.Uuid
  description   String?
  /// Qty the customer selected (transaction unit)
  quantity      Decimal       @default(1) @db.Decimal(20, 8)
  unitPrice     Decimal       @default(0) @map("unit_price") @db.Decimal(14, 4)
  lineTotal     Decimal       @default(0) @map("line_total") @db.Decimal(12, 2)
  taxAmount     Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  /// Snapshot: ordered qty (same as quantity when set). Null = legacy line.
  orderedQuantity     Decimal? @map("ordered_quantity") @db.Decimal(20, 8)
  orderedUnitId       String?  @map("ordered_unit_id") @db.Uuid
  orderedUnitSymbol   String?  @map("ordered_unit_symbol") @db.VarChar(16)
  /// Canonical inventory qty at transaction time (never recompute from live config)
  baseQuantity        Decimal? @map("base_quantity") @db.Decimal(20, 8)
  baseUnitId          String?  @map("base_unit_id") @db.Uuid
  baseUnitSymbol      String?  @map("base_unit_symbol") @db.VarChar(16)
  conversionFactor    Decimal? @map("conversion_factor") @db.Decimal(20, 8)
  priceSource         String?  @map("price_source") @db.VarChar(24)
  meta          Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  order       Order              @relation(fields: [orderId], references: [id])
  product     Product?           @relation(fields: [productId], references: [id])
  stockUnit   StockUnit?         @relation(fields: [stockUnitId], references: [id])
  stockLevel  StockLevel?        @relation(fields: [stockLevelId], references: [id])
  wearer      Customer?          @relation("ItemWearer", fields: [wearerCustomerId], references: [id])
  reservations       StockReservation[]
  kitchenTicketLines KitchenTicketLine[]

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  tenantId              String        @map("tenant_id") @db.Uuid
  orderId               String        @map("order_id") @db.Uuid
  locationId            String?       @map("location_id") @db.Uuid
  registerSessionId     String?       @map("register_session_id") @db.Uuid
  type                  PaymentType   @default(payment)
  method                PaymentMethod
  status                PaymentStatus @default(pending)
  amount                Decimal       @db.Decimal(12, 2)
  currencyCode          String        @default("INR") @map("currency_code") @db.Char(3)
  idempotencyKey        String        @map("idempotency_key")
  provider              String?
  gatewayRef            String?       @map("gateway_ref")
  gatewayPayload        Json?         @map("gateway_payload")
  failureReason         String?       @map("failure_reason")
  parentPaymentId       String?       @map("parent_payment_id") @db.Uuid
  takenByUserId         String?       @map("taken_by_user_id") @db.Uuid
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  order           Order            @relation(fields: [orderId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  registerSession RegisterSession? @relation(fields: [registerSessionId], references: [id])
  takenBy         User?            @relation(fields: [takenByUserId], references: [id])
  parentPayment   Payment?         @relation("PaymentRefunds", fields: [parentPaymentId], references: [id])
  refunds         Payment[]        @relation("PaymentRefunds")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, gatewayRef])
  @@index([tenantId, registerSessionId])
  @@index([tenantId, orderId, status])
  @@map("payments")
}

/// Stripe (and future PSP) webhook inbox — unique event id for idempotency
model StripeWebhookEvent {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String?  @map("tenant_id") @db.Uuid
  stripeEventId    String   @unique @map("stripe_event_id")
  type             String
  paymentIntentId  String?  @map("payment_intent_id")
  processedAt      DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)
  payload          Json     @default("{}")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, paymentIntentId])
  @@map("stripe_webhook_events")
}

model OrderFee {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  stockUnitId String?  @map("stock_unit_id") @db.Uuid
  feeCode     String   @map("fee_code")
  reason      String?
  amount      Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  order     Order      @relation(fields: [orderId], references: [id])
  stockUnit StockUnit? @relation(fields: [stockUnitId], references: [id])

  @@map("order_fees")
}

model LayawaySchedule {
  id                String    @id @default(uuid()) @db.Uuid
  orderId           String    @map("order_id") @db.Uuid
  dueBy             DateTime  @map("due_by") @db.Date
  installmentAmount Decimal   @map("installment_amount") @db.Decimal(12, 2)
  status            String    @default("pending")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id])

  @@map("layaway_schedules")
}

model Invoice {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  orderId      String   @map("order_id") @db.Uuid
  invoiceNumber String  @map("invoice_number")
  taxIdSnapshot String? @map("tax_id_snapshot")
  /// Flexible tax breakdown: { cgst, sgst, igst } or { vat } etc.
  taxBreakdown Json     @default("{}") @map("tax_breakdown")
  cgst         Decimal  @default(0) @db.Decimal(12, 2)
  sgst         Decimal  @default(0) @db.Decimal(12, 2)
  igst         Decimal  @default(0) @db.Decimal(12, 2)
  grandTotal   Decimal  @map("grand_total") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@unique([tenantId, invoiceNumber])
  @@map("invoices")
}

model ReturnEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  stockUnitId     String?  @map("stock_unit_id") @db.Uuid
  receivedById    String?  @map("received_by") @db.Uuid
  approvedById    String?  @map("approved_by") @db.Uuid
  notes           String?
  /// requested | approved | processing | completed | rejected (legacy: pending)
  status          String   @default("completed")
  reasonCode      String?  @map("reason_code")
  refundAmount    Decimal? @map("refund_amount") @db.Decimal(12, 2)
  refundMethod    String?  @map("refund_method")
  /// Sale return lines: [{ stockLevelId, quantity, unitPrice, condition? }]
  itemsJson       Json     @default("[]") @map("items_json")
  idempotencyKey  String?  @map("idempotency_key")
  rejectReason    String?  @map("reject_reason")
  /// Optional link to original payment being refunded
  parentPaymentId String?  @map("parent_payment_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  order      Order      @relation(fields: [orderId], references: [id])
  stockUnit  StockUnit? @relation(fields: [stockUnitId], references: [id])
  receivedBy User?      @relation("ReturnReceivedBy", fields: [receivedById], references: [id])
  approvedBy User?      @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, orderId])
  @@map("return_events")
}

/// Tenant refund reason catalog (sale returns)
model RefundReason {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  label     String
  /// customer | supplier | both
  appliesTo String   @default("customer") @map("applies_to")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("refund_reasons")
}

/// Open cash drawer / register shift (POS module)
model RegisterSession {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  locationId  String    @map("location_id") @db.Uuid
  openedById  String    @map("opened_by") @db.Uuid
  openingFloat Decimal  @default(0) @map("opening_float") @db.Decimal(12, 2)
  closingCash  Decimal? @map("closing_cash") @db.Decimal(12, 2)
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(6)
