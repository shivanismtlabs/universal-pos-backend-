// ─── Phase 2: expenses + loyalty coupons ────────────────────────────────────

model ExpenseCategory {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  parentId         String?  @map("parent_id") @db.Uuid
