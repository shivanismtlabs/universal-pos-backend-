  customerId String  @map("customer_id") @db.Uuid
  roleLabel  String? @map("role_label")

  party    ModRentalParty @relation(fields: [partyId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])

  @@id([partyId, customerId])
  @@map("mod_rental_party_members")
}

model ModRentalMeasurement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  heightCm      Decimal? @map("height_cm") @db.Decimal(8, 2)
  weightKg      Decimal? @map("weight_kg") @db.Decimal(8, 2)
  chest         Decimal? @db.Decimal(8, 2)
  waist         Decimal? @db.Decimal(8, 2)
  inseam        Decimal? @db.Decimal(8, 2)
  sleeve        Decimal? @db.Decimal(8, 2)
  shoeSize      String?  @map("shoe_size")
  extras        Json     @default("{}")
  takenByUserId String?  @map("taken_by_user_id") @db.Uuid
  takenAt       DateTime @default(now()) @map("taken_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  takenBy  User?    @relation(fields: [takenByUserId], references: [id])

  @@map("mod_rental_measurements")
}

model ModRentalCleaningJob {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  stockUnitId String   @map("stock_unit_id") @db.Uuid
  status      String   @default("queued")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])

  @@map("mod_rental_cleaning_jobs")
}

model ModRentalDamageRecord {
  id            String         @id @default(uuid()) @db.Uuid
  tenantId      String         @map("tenant_id") @db.Uuid
  stockUnitId   String         @map("stock_unit_id") @db.Uuid
  inspectStatus InspectStatus  @map("inspect_status")
  notes         String?
  chargeAmount  Decimal?       @map("charge_amount") @db.Decimal(12, 2)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  stockUnit StockUnit @relation(fields: [stockUnitId], references: [id])

  @@map("mod_rental_damage_records")
}

// ─── Accounting (double-entry GL + external adapters) ───────────────────────

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

enum IntegrationSyncStatus {
  PENDING
  PROCESSING
  SYNCED
  FAILED
  RETRYING
}

/// Tenant Chart of Accounts — configurable, not industry-hardcoded.
model GlAccount {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  code        String
  name        String
  type        GlAccountType
  /// CURRENT_ASSET | FIXED_ASSET | CURRENT_LIABILITY | LONG_TERM_LIABILITY | EQUITY | REVENUE | CONTRA_REVENUE | COGS | OPERATING_EXPENSE | OTHER_INCOME | OTHER_EXPENSE
  subtype     String?
  category    String?
  description String?
  isActive    Boolean       @default(true) @map("is_active")
  isSystem    Boolean       @default(false) @map("is_system")
  createdById String?       @map("created_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  parent   GlAccount?        @relation("GlAccountTree", fields: [parentId], references: [id])
  children GlAccount[]       @relation("GlAccountTree")
  createdBy User?            @relation("GlAccountCreatedBy", fields: [createdById], references: [id])
  lines    JournalEntryLine[]
  mappings AccountMapping[]
  externalMaps IntegrationExternalMap[]

  @@unique([tenantId, code])
  @@index([tenantId, type, isActive])
  @@index([tenantId, parentId])
  @@map("gl_accounts")
}

model JournalEntry {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  locationId    String?       @map("location_id") @db.Uuid
  entryNumber   String        @map("entry_number")
  entryDate     DateTime      @map("entry_date") @db.Date
  sourceType    String        @map("source_type")
  sourceId      String?       @map("source_id") @db.Uuid
  /// tenant-unique idempotency key e.g. SALE:<orderId>
  sourceKey     String?       @map("source_key")
  description   String?
  status        JournalStatus @default(DRAFT)
  createdById   String?       @map("created_by") @db.Uuid
  postedById    String?       @map("posted_by") @db.Uuid
  reversedById  String?       @map("reversed_by") @db.Uuid
  postedAt      DateTime?     @map("posted_at") @db.Timestamptz(6)
  reversedAt    DateTime?     @map("reversed_at") @db.Timestamptz(6)
  reversalOfId  String?       @map("reversal_of_id") @db.Uuid
  meta          Json          @default("{}")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  location   Location?          @relation(fields: [locationId], references: [id])
  createdBy  User?              @relation("JournalCreatedBy", fields: [createdById], references: [id])
  postedBy   User?              @relation("JournalPostedBy", fields: [postedById], references: [id])
  reversedBy User?              @relation("JournalReversedBy", fields: [reversedById], references: [id])
  reversalOf JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversals  JournalEntry[]     @relation("JournalReversal")
  lines      JournalEntryLine[]
  taxFacts   AccountingTaxFact[]
  syncJobs   IntegrationSyncJob[]

  @@unique([tenantId, entryNumber])
  @@unique([tenantId, sourceKey])
  @@index([tenantId, entryDate, status])
  @@index([tenantId, sourceType, sourceId])
  @@index([tenantId, locationId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  customerId     String?  @map("customer_id") @db.Uuid
  supplierId     String?  @map("supplier_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  taxId          String?  @map("tax_id")
  description    String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  journalEntry  JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account       GlAccount    @relation(fields: [accountId], references: [id])
  customer      Customer?    @relation(fields: [customerId], references: [id])
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  location      Location?    @relation(fields: [locationId], references: [id])

  @@index([tenantId, accountId])
  @@index([journalEntryId])
  @@index([tenantId, customerId])
  @@index([tenantId, supplierId])
  @@index([tenantId, locationId])
  @@map("journal_entry_lines")
}

model AccountingPeriod {
  id           String                   @id @default(uuid()) @db.Uuid
  tenantId     String                   @map("tenant_id") @db.Uuid
  name         String
  startDate    DateTime                 @map("start_date") @db.Date
  endDate      DateTime                 @map("end_date") @db.Date
  status       AccountingPeriodStatus   @default(OPEN)
  closedAt     DateTime?                @map("closed_at") @db.Timestamptz(6)
  closedById   String?                  @map("closed_by") @db.Uuid
  reopenedAt   DateTime?                @map("reopened_at") @db.Timestamptz(6)
  reopenedById String?                  @map("reopened_by") @db.Uuid
  createdById  String?                  @map("created_by") @db.Uuid
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  createdBy  User?  @relation("PeriodCreatedBy", fields: [createdById], references: [id])
  closedBy   User?  @relation("PeriodClosedBy", fields: [closedById], references: [id])
  reopenedBy User?  @relation("PeriodReopenedBy", fields: [reopenedById], references: [id])

  @@index([tenantId, startDate, endDate])
  @@index([tenantId, status])
  @@map("accounting_periods")
}

/// Maps POS transaction/payment/tax keys → GL accounts (tenant, optional location).
model AccountMapping {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  locationId      String?  @map("location_id") @db.Uuid
  mappingKey      String   @map("mapping_key")
  /// '*' for tenant-wide, else location UUID — keeps unique constraint with nullable location
  scopeKey        String   @default("*") @map("scope_key")
  accountId       String   @map("account_id") @db.Uuid
  taxType         String?  @map("tax_type")
  paymentMethod   String?  @map("payment_method")
  transactionType String?  @map("transaction_type")
  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])
  account   GlAccount @relation(fields: [accountId], references: [id])
  createdBy User?     @relation("AccountMappingCreatedBy", fields: [createdById], references: [id])

  @@unique([tenantId, mappingKey, scopeKey])
  @@index([tenantId, mappingKey])
  @@map("account_mappings")
}

/// Tax breakdown stored when a journal is posted (not recomputed only at report time).
model AccountingTaxFact {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  journalEntryId String   @map("journal_entry_id") @db.Uuid
  locationId     String?  @map("location_id") @db.Uuid
  sourceType     String   @map("source_type")
  sourceId       String?  @map("source_id") @db.Uuid
  /// OUTPUT | INPUT
  direction      String
  /// CGST | SGST | IGST | CESS | GST | OTHER | VAT
  taxType        String   @map("tax_type")
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxableValue   Decimal  @default(0) @map("taxable_value") @db.Decimal(14, 2)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(14, 2)
  hsnSac         String?  @map("hsn_sac")
  placeOfSupply  String?  @map("place_of_supply")
  /// B2B | B2C | UNREGISTERED
  partyType      String?  @map("party_type")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])

  @@index([tenantId, journalEntryId])
  @@index([tenantId, direction, taxType])
  @@index([tenantId, sourceType, sourceId])
  @@map("accounting_tax_facts")
}

model IntegrationConnection {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// TALLY | QUICKBOOKS | ZOHO_BOOKS
  provider      String
  /// disconnected | connected | error
  status        String    @default("disconnected")
  /// AES-GCM encrypted JSON (OAuth tokens, company ids) — never plaintext
  configEnc     String?   @map("config_enc")
  externalOrgId String?   @map("external_org_id")
  lastTestedAt  DateTime? @map("last_tested_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdById   String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User?  @relation("IntegrationConnectedBy", fields: [createdById], references: [id])
  maps      IntegrationExternalMap[]
  jobs      IntegrationSyncJob[]
  logs      IntegrationSyncLog[]

  @@unique([tenantId, provider])
  @@map("integration_connections")
}

model IntegrationExternalMap {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  connectionId  String?   @map("connection_id") @db.Uuid
  provider      String
  /// account | customer | supplier | item | tax | payment_method
  entityType    String    @map("entity_type")
  localId       String    @map("local_id")
  externalId    String    @map("external_id")
  externalName  String?   @map("external_name")
  status        String    @default("mapped")
  accountId     String?   @map("account_id") @db.Uuid
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant     Tenant                  @relation(fields: [tenantId], references: [id])
  account    GlAccount?              @relation(fields: [accountId], references: [id])
  connection IntegrationConnection?  @relation(fields: [connectionId], references: [id])

  @@unique([tenantId, provider, entityType, localId])
  @@index([tenantId, provider, entityType])
  @@map("integration_external_maps")
}

model IntegrationSyncJob {
  id             String                 @id @default(uuid()) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  connectionId   String?                @map("connection_id") @db.Uuid
  provider       String
  entityType     String                 @map("entity_type")
  localEntityId  String                 @map("local_entity_id") @db.Uuid
  journalEntryId String?                @map("journal_entry_id") @db.Uuid
  operation      String                 @default("create")
  status         IntegrationSyncStatus  @default(PENDING)
  attemptCount   Int                    @default(0) @map("attempt_count")
  nextAttemptAt  DateTime?              @map("next_attempt_at") @db.Timestamptz(6)
  lastAttemptAt  DateTime?              @map("last_attempt_at") @db.Timestamptz(6)
  syncedAt       DateTime?              @map("synced_at") @db.Timestamptz(6)
  errorMessage   String?                @map("error_message")
  idempotencyKey String                 @map("idempotency_key")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant                  @relation(fields: [tenantId], references: [id])
  journalEntry JournalEntry?           @relation(fields: [journalEntryId], references: [id])
  connection   IntegrationConnection?  @relation(fields: [connectionId], references: [id])

  @@unique([tenantId, provider, entityType, localEntityId, operation])
  @@index([tenantId, status, nextAttemptAt])
  @@index([tenantId, idempotencyKey])
  @@map("integration_sync_jobs")
}

model IntegrationSyncLog {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  connectionId     String?   @map("connection_id") @db.Uuid
  provider         String
  entityType       String    @map("entity_type")
  localEntityId    String?   @map("local_entity_id")
  externalEntityId String?   @map("external_entity_id")
  operation        String
  status           String
  /// Non-secret request metadata (ids, counts) — never OAuth tokens
  requestMeta      Json?     @map("request_meta")
  errorMessage     String?   @map("error_message")
  attemptCount     Int       @default(0) @map("attempt_count")
  lastAttemptAt    DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  syncedAt         DateTime? @map("synced_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id])
  connection IntegrationConnection? @relation(fields: [connectionId], references: [id])

  @@index([tenantId, provider, createdAt])
  @@index([tenantId, localEntityId])
  @@map("integration_sync_logs")
}

// ─── BusinessGroup enterprise layer (holding company) ───────────────────────
// Tenant remains the isolation + legal/workflow boundary.
// Group is billing, consolidation, All Businesses — sharing is opt-in.

model BusinessGroup {
  id               String   @id @default(uuid()) @db.Uuid
  name             String
  slug             String   @unique
  ownerIdentityId  String   @map("owner_identity_id") @db.Uuid
  /// Entitlement codes + alert defaults (not a second RBAC)
  entitlements     Json     @default("[]")
  settings         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner           IdentityAccount              @relation("GroupOwner", fields: [ownerIdentityId], references: [id])
  tenants         Tenant[]
  memberships     BusinessGroupMembership[]
  approvalPolicies ApprovalPolicy[]
  approvalRequests ApprovalRequest[]
  exceptionRules  ExceptionAlertRule[]
  intercompany    IntercompanyTransfer[]
  spinOffs        BusinessSpinOff[]
  supplierLinks   GroupSupplierLink[]
  customerLinks   GroupCustomerLink[]

  @@index([ownerIdentityId])
  @@map("business_groups")
}

/// Identity ↔ group (owner may see rollups; member does not get tenant access)
model BusinessGroupMembership {
  id          String   @id @default(uuid()) @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  identityId  String   @map("identity_id") @db.Uuid
  /// owner | finance | auditor | member
  role        String   @default("member")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group    BusinessGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  identity IdentityAccount @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@unique([groupId, identityId])
  @@index([identityId])
  @@map("business_group_memberships")
}

model ApprovalPolicy {
  id              String   @id @default(uuid()) @db.Uuid
  businessGroupId String   @map("business_group_id") @db.Uuid
  tenantId        String?  @map("tenant_id") @db.Uuid
  /// refund | discount | purchase | stock_adjustment | stock_transfer | price_change | credit_sale | expense | intercompany
  type            String
  enabled         Boolean  @default(true)
  /// { steps: [{ role, maxAmount?, maxPercent? }], cashierMaxPercent?, cashierMaxAmount? }
  config          Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  group  BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([businessGroupId, type])
  @@index([tenantId, type])
  @@map("approval_policies")
}

model ApprovalRequest {
  id              String    @id @default(uuid()) @db.Uuid
  businessGroupId String    @map("business_group_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  type            String
  entityType      String    @map("entity_type")
  entityId        String?   @map("entity_id")
  requestedById   String?   @map("requested_by_id") @db.Uuid
  resolvedById    String?   @map("resolved_by_id") @db.Uuid
  amount          Decimal?  @db.Decimal(14, 2)
  reason          String?
  /// pending | approved | rejected | cancelled
  status          String    @default("pending")
  currentStep     Int       @default(0) @map("current_step")
  payload         Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)

  group       BusinessGroup  @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User?          @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?          @relation("ApprovalResolvedBy", fields: [resolvedById], references: [id])
  steps       ApprovalStep[]

  @@index([tenantId, status, createdAt])
  @@index([businessGroupId, status, createdAt])
  @@map("approval_requests")
}

model ApprovalStep {
  id        String    @id @default(uuid()) @db.Uuid
  requestId String    @map("request_id") @db.Uuid
  stepIndex Int       @map("step_index")
  /// pending | approved | rejected | skipped
  status    String    @default("pending")
  actorId   String?   @map("actor_id") @db.Uuid
  note      String?
  actedAt   DateTime? @map("acted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?           @relation("ApprovalStepActor", fields: [actorId], references: [id])

  @@index([requestId, stepIndex])
  @@map("approval_steps")
}

model ExceptionAlertRule {
  id              String    @id @default(uuid()) @db.Uuid
  businessGroupId String    @map("business_group_id") @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  /// sales_drop | cash_mismatch | unusual_discount | large_refund | inventory_shrinkage | low_stock | dead_stock | overdue_ap | overdue_ar | unusual_expense | negative_margin | high_return_rate
  type            String
  enabled         Boolean   @default(true)
  threshold       Decimal?  @db.Decimal(14, 4)
  /// minutes
  cooldownMinutes Int       @default(360) @map("cooldown_minutes")
  /// identity ids and/or roles
  recipients      Json      @default("{}")
  lastFiredAt     DateTime? @map("last_fired_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  group  BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([businessGroupId, type])
  @@map("exception_alert_rules")
}

model IntercompanyTransfer {
  id                  String    @id @default(uuid()) @db.Uuid
  businessGroupId     String    @map("business_group_id") @db.Uuid
  sourceTenantId      String    @map("source_tenant_id") @db.Uuid
  destinationTenantId String    @map("destination_tenant_id") @db.Uuid
  sourceLocationId    String    @map("source_location_id") @db.Uuid
  destinationLocationId String  @map("destination_location_id") @db.Uuid
  /// draft | pending_approval | issued | in_transit | received | cancelled
  status              String    @default("draft")
  notes               String?
  createdById         String?   @map("created_by_id") @db.Uuid
  approvedById        String?   @map("approved_by_id") @db.Uuid
  issuedAt            DateTime? @map("issued_at") @db.Timestamptz(6)
  receivedAt          DateTime? @map("received_at") @db.Timestamptz(6)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  group       BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  sourceTenant Tenant       @relation("IcSourceTenant", fields: [sourceTenantId], references: [id])
  destTenant   Tenant       @relation("IcDestTenant", fields: [destinationTenantId], references: [id])
  createdBy    User?        @relation("IcCreatedBy", fields: [createdById], references: [id])
  approvedBy   User?        @relation("IcApprovedBy", fields: [approvedById], references: [id])
  lines        IntercompanyTransferLine[]

  @@index([businessGroupId, status, createdAt])
  @@index([sourceTenantId, createdAt])
  @@index([destinationTenantId, createdAt])
  @@map("intercompany_transfers")
}

model IntercompanyTransferLine {
  id          String  @id @default(uuid()) @db.Uuid
  transferId  String  @map("transfer_id") @db.Uuid
  sku         String  @db.VarChar(18)
  name        String
  sourceProductId String? @map("source_product_id") @db.Uuid
  destProductId   String? @map("dest_product_id") @db.Uuid
  quantity    Decimal @db.Decimal(20, 8)
  unitCost    Decimal @default(0) @map("unit_cost") @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @map("tax_amount") @db.Decimal(12, 2)

  transfer IntercompanyTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("intercompany_transfer_lines")
}

model BusinessSpinOff {
  id              String    @id @default(uuid()) @db.Uuid
  businessGroupId String    @map("business_group_id") @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// pending | exported | detached | cancelled
  status          String    @default("pending")
  requestedByIdentityId String @map("requested_by_identity_id") @db.Uuid
  exportPayload   Json      @default("{}") @map("export_payload")
  confirmation    String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  group  BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id])

  @@index([businessGroupId, status])
  @@map("business_spin_offs")
}

/// Optional group supplier directory — PO stays on a legal tenant
model GroupSupplierLink {
  id              String   @id @default(uuid()) @db.Uuid
  businessGroupId String   @map("business_group_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  displayName     String
  phone           String?
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group  BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([businessGroupId, tenantId, supplierId])
  @@index([businessGroupId, displayName])
  @@map("group_supplier_links")
}

/// Opt-in group customer match (phone/email/gst) — never auto-merge
model GroupCustomerLink {
  id              String   @id @default(uuid()) @db.Uuid
  businessGroupId String   @map("business_group_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  customerId      String   @map("customer_id") @db.Uuid
  matchKey        String   @map("match_key")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group  BusinessGroup @relation(fields: [businessGroupId], references: [id], onDelete: Cascade)
  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([businessGroupId, tenantId, customerId])
  @@index([businessGroupId, matchKey])
  @@map("group_customer_links")
}

// ─── Restaurant pack (optional) ─────────────────────────────────────────────
// Overlay on Universal Core. Does not replace Order / Payment / Inventory.
// Runtime gate: capabilities TABLE | KOT | KITCHEN — never if (businessType === 'restaurant').

enum DiningMode {
  dine_in
  takeaway
  delivery
  pickup
  online
}

enum DiningTableStatus {
  available
  occupied
  reserved
  cleaning
  blocked
}

enum KitchenTicketStatus {
  new
  accepted
  preparing
  ready
  served
  cancelled
}

enum RestaurantOrderChannel {
  pos
  qr
  website
  aggregator
  phone
  manual
}

/// Tenant restaurant-pack settings. One row per shop (optional location default).
model RestaurantConfig {
  id                     String   @id @default(uuid()) @db.Uuid
  tenantId               String   @unique @map("tenant_id") @db.Uuid
  locationId             String?  @map("location_id") @db.Uuid
  enabledDiningModes     Json     @default("[\"dine_in\", \"takeaway\"]") @map("enabled_dining_modes")
  tableManagement        Boolean  @default(true) @map("table_management")
  kotEnabled             Boolean  @default(true) @map("kot_enabled")
  kdsEnabled             Boolean  @default(false) @map("kds_enabled")
  captainOrdering        Boolean  @default(false) @map("captain_ordering")
  qrOrdering             Boolean  @default(false) @map("qr_ordering")
  onlineOrdering         Boolean  @default(false) @map("online_ordering")
  recipesEnabled         Boolean  @default(false) @map("recipes_enabled")
  reservationsEnabled    Boolean  @default(false) @map("reservations_enabled")
  tokenManagement        Boolean  @default(false) @map("token_management")
  /// order_finalize (default) | kot_confirm — never both
  consumptionPolicy      String   @default("order_finalize") @map("consumption_policy") @db.VarChar(32)
  serviceChargePercent   Decimal? @map("service_charge_percent") @db.Decimal(6, 3)
  packagingCharge        Decimal? @map("packaging_charge") @db.Decimal(12, 2)
  deliveryCharge         Decimal? @map("delivery_charge") @db.Decimal(12, 2)
  prepWarnMinutes        Int      @default(10) @map("prep_warn_minutes")
  prepCriticalMinutes    Int      @default(20) @map("prep_critical_minutes")
  otpOnQrOrder           Boolean  @default(false) @map("otp_on_qr_order")
  meta                   Json     @default("{}")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@map("restaurant_configs")
}

model RestaurantFloor {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  name       String
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant            @relation(fields: [tenantId], references: [id])
  location Location          @relation(fields: [locationId], references: [id])
  tables   RestaurantTable[]

  @@index([tenantId, locationId])
  @@map("restaurant_floors")
}

/// Dining table overlay on generic Resource (type=table). Status lives here so salon rooms stay untouched.
model RestaurantTable {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  locationId     String             @map("location_id") @db.Uuid
  floorId        String?            @map("floor_id") @db.Uuid
  resourceId     String             @unique @map("resource_id") @db.Uuid
  name           String
  capacity       Int                @default(2)
  status         DiningTableStatus  @default(available)
  currentOrderId String?            @map("current_order_id") @db.Uuid
  sortOrder      Int                @default(0) @map("sort_order")
  qrToken        String?            @unique @map("qr_token")
  meta           Json               @default("{}")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  location     Location          @relation(fields: [locationId], references: [id])
  floor        RestaurantFloor?  @relation(fields: [floorId], references: [id])
  resource     Resource          @relation(fields: [resourceId], references: [id])
  currentOrder Order?            @relation(fields: [currentOrderId], references: [id])
  tickets      KitchenTicket[]
  diningOrders RestaurantOrder[]
  reservations DiningReservation[]

  @@index([tenantId, locationId, status])
  @@index([tenantId, currentOrderId])
  @@map("restaurant_tables")
}

model KitchenStation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String?  @map("location_id") @db.Uuid
  name       String
  code       String   @db.VarChar(40)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  location Location?           @relation(fields: [locationId], references: [id])
  tickets  KitchenTicket[]
  lines    KitchenTicketLine[]

  @@unique([tenantId, code])
  @@index([tenantId, locationId])
  @@map("kitchen_stations")
}

model KitchenTicket {
  id                    String               @id @default(uuid()) @db.Uuid
  tenantId              String               @map("tenant_id") @db.Uuid
  locationId            String               @map("location_id") @db.Uuid
  orderId               String               @map("order_id") @db.Uuid
  tableId               String?              @map("table_id") @db.Uuid
  stationId             String?              @map("station_id") @db.Uuid
  kotNumber             String               @map("kot_number")
  diningMode            DiningMode           @default(dine_in) @map("dining_mode")
  status                KitchenTicketStatus  @default(new)
  priority              Int                  @default(0)
  specialInstructions   String?              @map("special_instructions")
  createdById           String?              @map("created_by_id") @db.Uuid
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  cancelReason          String?              @map("cancel_reason")
  cancelledById         String?              @map("cancelled_by_id") @db.Uuid
  acceptedAt            DateTime?            @map("accepted_at") @db.Timestamptz(6)
  preparingAt           DateTime?            @map("preparing_at") @db.Timestamptz(6)
  readyAt               DateTime?            @map("ready_at") @db.Timestamptz(6)
  servedAt              DateTime?            @map("served_at") @db.Timestamptz(6)
  recalledAt            DateTime?            @map("recalled_at") @db.Timestamptz(6)
  idempotencyKey        String?              @map("idempotency_key") @db.VarChar(160)
  meta                  Json                 @default("{}")
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  location    Location             @relation(fields: [locationId], references: [id])
  order       Order                @relation(fields: [orderId], references: [id])
  table       RestaurantTable?     @relation(fields: [tableId], references: [id])
  station     KitchenStation?      @relation(fields: [stationId], references: [id])
  createdBy   User?                @relation("KitchenTicketCreatedBy", fields: [createdById], references: [id])
  cancelledBy User?                @relation("KitchenTicketCancelledBy", fields: [cancelledById], references: [id])
  lines       KitchenTicketLine[]

  @@unique([tenantId, kotNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, locationId, status])
  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
  @@map("kitchen_tickets")
}

model KitchenTicketLine {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @map("tenant_id") @db.Uuid
  ticketId    String              @map("ticket_id") @db.Uuid
  orderItemId String?             @map("order_item_id") @db.Uuid
  stationId   String?             @map("station_id") @db.Uuid
  name        String
  quantity    Decimal             @default(1) @db.Decimal(20, 8)
  notes       String?
  modifiers   Json                @default("[]")
  status      KitchenTicketStatus @default(new)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  ticket    KitchenTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem OrderItem?          @relation(fields: [orderItemId], references: [id])
  station   KitchenStation?     @relation(fields: [stationId], references: [id])

  @@index([ticketId])
  @@index([tenantId, orderItemId])
  @@map("kitchen_ticket_lines")
}

/// 1:1 dining overlay on core Order. Inventory consumption is posted once via POS checkout.
model RestaurantOrder {
  id                  String                 @id @default(uuid()) @db.Uuid
  tenantId            String                 @map("tenant_id") @db.Uuid
  locationId          String                 @map("location_id") @db.Uuid
  orderId             String                 @unique @map("order_id") @db.Uuid
  tableId             String?                @map("table_id") @db.Uuid
  diningMode          DiningMode             @default(dine_in) @map("dining_mode")
  channel             RestaurantOrderChannel @default(pos)
  covers              Int                    @default(1)
  tokenNumber         Int?                   @map("token_number")
  kitchenPhase        String?                @map("kitchen_phase") @db.VarChar(40)
  guestName           String?                @map("guest_name")
  deliveryAddress     String?                @map("delivery_address")
  mergedFromTableIds  Json                   @default("[]") @map("merged_from_table_ids")
  parentOrderId       String?                @map("parent_order_id") @db.Uuid
  /// true after checkout posts inventory — prevents KOT + bill double-deduct
  consumptionPosted   Boolean                @default(false) @map("consumption_posted")
  billedAt            DateTime?              @map("billed_at") @db.Timestamptz(6)
  meta                Json                   @default("{}")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  order    Order            @relation(fields: [orderId], references: [id])
  table    RestaurantTable? @relation(fields: [tableId], references: [id])

  @@index([tenantId, locationId, diningMode])
  @@index([tenantId, tableId])
  @@map("restaurant_orders")
}

model DiningReservation {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  locationId String   @map("location_id") @db.Uuid
  tableId    String?  @map("table_id") @db.Uuid
  guestName  String   @map("guest_name")
  guestPhone String?  @map("guest_phone")
  covers     Int      @default(2)
  startAt    DateTime @map("start_at") @db.Timestamptz(6)
  status     String   @default("booked") @db.VarChar(20)
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  location Location         @relation(fields: [locationId], references: [id])
  table    RestaurantTable? @relation(fields: [tableId], references: [id])

  @@index([tenantId, locationId, startAt])
  @@map("dining_reservations")
}

/// Optional production stages on a recipe (dough → sauce → assemble).
model RecipeStage {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  name             String
  sortOrder        Int      @default(0) @map("sort_order")
  outputProductId  String?  @map("output_product_id") @db.Uuid
  outputQty        Decimal  @default(1) @map("output_qty") @db.Decimal(20, 8)
  meta             Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  product  Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines    ProductBundleLine[]

  @@index([tenantId, productId])
  @@map("recipe_stages")
}

model ModifierGroup {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  name       String
  minSelect  Int      @default(0) @map("min_select")
  maxSelect  Int      @default(1) @map("max_select")
  required   Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  meta       Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  options  ModifierOption[]
  products ProductModifierGroup[]

  @@index([tenantId, name])
  @@map("modifier_groups")
}

model ModifierOption {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  groupId          String   @map("group_id") @db.Uuid
  name             String
  priceDelta       Decimal  @default(0) @map("price_delta") @db.Decimal(12, 2)
  linkedProductId  String?  @map("linked_product_id") @db.Uuid
  consumeQty       Decimal? @map("consume_qty") @db.Decimal(20, 8)
  isActive         Boolean  @default(true) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  group          ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  linkedProduct  Product?      @relation("modifierIngredient", fields: [linkedProductId], references: [id])

  @@index([tenantId, groupId])
  @@map("modifier_options")
}

model ProductModifierGroup {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  groupId    String   @map("group_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([productId, groupId])
  @@index([tenantId, productId])
  @@map("product_modifier_groups")
}

/// Auditable dining/ops write-off — stock still moves via StockLedgerEntry.
model WastageEvent {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  locationId      String   @map("location_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  stockLevelId    String?  @map("stock_level_id") @db.Uuid
  qty             Decimal  @db.Decimal(20, 8)
  unit            String?  @db.VarChar(16)
  reason          String   @db.VarChar(40)
  notes           String?
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  ledgerEntryId   String?  @map("ledger_entry_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  location Location  @relation(fields: [locationId], references: [id])
  actor    User?     @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, productId, createdAt])
  @@map("wastage_events")
}
