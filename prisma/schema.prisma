  location Location @relation(fields: [locationId], references: [id])
  openedBy User     @relation(fields: [openedById], references: [id])
  payments Payment[]
  cashMovements RegisterCashMovement[]

  @@index([tenantId, locationId, closedAt])
  @@map("register_sessions")
}

/// Cash in / cash drop against an open register shift
model RegisterCashMovement {
  id                String                    @id @default(uuid()) @db.Uuid
  tenantId          String                    @map("tenant_id") @db.Uuid
  registerSessionId String                    @map("register_session_id") @db.Uuid
